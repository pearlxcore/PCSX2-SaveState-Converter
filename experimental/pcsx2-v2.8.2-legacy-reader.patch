+// --------------------------------------------------------------------------------------
+//  Archive level
+// --------------------------------------------------------------------------------------
+namespace
+{
+	static constexpr const char* ENTRY_VERSION = "PCSX2 Savestate Version.id";
+	static constexpr const char* ENTRY_SCREENSHOT = "Screenshot.png";
+	static constexpr const char* ENTRY_INTERNALS = "PCSX2 Internal Structures.dat";
+
+	enum class Kind
+	{
+		Memory,
+		SPU2,
+		Wrapper,
+		GS,
+		Optional,
+	};
+
+	struct KnownEntry
+	{
+		const char* name;
+		Kind kind;
+		bool required;
+		u32 size_a; // accepted sizes for raw memory images
+		u32 size_b;
+		const char* marker; // first StateWrapper marker
+	};
+
+	// Same order as SavestateEntries[] in SaveState.cpp.
+	static const KnownEntry s_entries[] = {
+		{"eeMemory.bin", Kind::Memory, true, Ps2MemSize::MainRam, Ps2MemSize::TotalRam, nullptr},
+		{"iopMemory.bin", Kind::Memory, true, Ps2MemSize::IopRam, Ps2MemSize::TotalIopRam, nullptr},
+		{"eeHwRegs.bin", Kind::Memory, true, Ps2MemSize::Hardware, Ps2MemSize::Hardware, nullptr},
+		{"iopHwRegs.bin", Kind::Memory, true, Ps2MemSize::IopHardware, Ps2MemSize::IopHardware, nullptr},
+		{"Scratchpad.bin", Kind::Memory, true, Ps2MemSize::Scratch, Ps2MemSize::Scratch, nullptr},
+		{"vu0Memory.bin", Kind::Memory, true, VU0_MEMSIZE, VU0_MEMSIZE, nullptr},
+		{"vu1Memory.bin", Kind::Memory, true, VU1_MEMSIZE, VU1_MEMSIZE, nullptr},
+		{"vu0MicroMem.bin", Kind::Memory, true, VU0_PROGSIZE, VU0_PROGSIZE, nullptr},
+		{"vu1MicroMem.bin", Kind::Memory, true, VU1_PROGSIZE, VU1_PROGSIZE, nullptr},
+		{"SPU2.bin", Kind::SPU2, true, 0, 0, nullptr},
+		{"USB.bin", Kind::Wrapper, false, 0, 0, "USB"},
+		{"PAD.bin", Kind::Wrapper, true, 0, 0, "PAD"},
+		{"GS.bin", Kind::GS, true, 0, 0, nullptr},
+		{"Achievements.bin", Kind::Optional, false, 0, 0, nullptr},
+	};
+
+	static std::optional<std::vector<u8>> ReadEntry(zip_t* zf, const char* name)
+	{
+		const zip_int64_t index = zip_name_locate(zf, name, 0);
+		if (index < 0)
+			return std::nullopt;
+		zip_stat_t zst;
+		if (zip_stat_index(zf, index, 0, &zst) != 0 || !(zst.valid & ZIP_STAT_SIZE) || zst.size > 256 * _1mb)
+			return std::nullopt;
+		auto file = zip_fopen_index_managed(zf, index, 0);
+		if (!file)
+			return std::nullopt;
+		std::vector<u8> data(static_cast<size_t>(zst.size));
+		if (zip_fread(file.get(), data.data(), data.size()) != static_cast<zip_int64_t>(data.size()))
+			return std::nullopt;
+		return data;
+	}
+
+	static bool StartsWithMarker(const std::vector<u8>& data, const char* marker)
+	{
+		const u32 length = static_cast<u32>(std::strlen(marker));
+		u32 stored;
+		if (data.size() < sizeof(u32) + length)
+			return false;
+		std::memcpy(&stored, data.data(), sizeof(stored));
+		return stored == length && std::memcmp(data.data() + sizeof(u32), marker, length) == 0;
+	}
+
+	// Version indicator: g_SaveVersion followed by a 32-byte build description.
+	struct VersionRecord
+	{
+		u32 version;
+		char build[32];
+	};
+	static_assert(sizeof(VersionRecord) == 36);
+
+	static VersionRecord MakeVersionRecord(const ConvertedState& state)
+	{
+		VersionRecord record = {};
+		record.version = static_cast<u32>(state.target_format) << 16;
+		StringUtil::Strlcpy(record.build, fmt::format("{} (converted)", state.source_build).c_str(), sizeof(record.build));
+		return record;
+	}
+
+	// zip_source_buffer() does not copy: every buffer, including `version`, must stay alive
+	// until the archive has been closed.
+	static bool AddEntries(zip_t* zf, const ConvertedState& state, const VersionRecord& version, bool compress, Error* error)
+	{
+		auto add = [&](const char* name, const void* data, size_t size, bool store) {
+			zip_source_t* zs = zip_source_buffer(zf, data, size, 0);
+			if (!zs)
+				return false;
+			const zip_int64_t index = zip_file_add(zf, name, zs, ZIP_FL_ENC_UTF_8 | ZIP_FL_OVERWRITE);
+			if (index < 0)
+			{
+				zip_source_free(zs);
+				return false;
+			}
+			if (store || !compress)
+				zip_set_file_compression(zf, index, ZIP_CM_STORE, 0);
+			else
+				zip_set_file_compression(zf, index, ZIP_CM_ZSTD, 0);
+			return true;
+		};
+
+		bool ok = add(ENTRY_VERSION, &version, sizeof(VersionRecord), true);
+		if (ok && !state.screenshot_png.empty())
+			ok = add(ENTRY_SCREENSHOT, state.screenshot_png.data(), state.screenshot_png.size(), true);
+		for (const Entry& entry : state.entries)
+			ok = ok && add(entry.name.c_str(), entry.data.data(), entry.data.size(), false);
+
+		if (!ok)
+			Error::SetStringFmt(error, "Failed to add converted entries to archive: {}", zip_strerror(zf));
+		return ok;
+	}
+} // namespace
+
+bool SaveStateLegacy::ConvertArchive(zip_t* zf, ConvertedState* out, Error* error)
+{
+	ConvertedState& state = *out;
+	Report& report = state.report;
+
+	std::optional<std::vector<u8>> version = ReadEntry(zf, ENTRY_VERSION);
+	if (!version.has_value() || version->size() < sizeof(u32))
+	{
+		Error::SetString(error, "Savestate file does not contain version indicator.");
+		return false;
+	}
+	std::memcpy(&state.source_version, version->data(), sizeof(u32));
+	if (version->size() >= sizeof(u32) + 32)
+	{
+		char build[33] = {};
+		std::memcpy(build, version->data() + sizeof(u32), 32);
+		state.source_build = build;
+	}
+	if (!IsLegacyVersion(state.source_version))
+	{
+		Error::SetStringFmt(error, "Format 0x{:04X} has no translation (supported: 0x9A4F, 0x9A50, 0x9A54, 0x9A55).", state.source_version >> 16);
+		return false;
+	}
+	// The Internal Structures stream is identical for 0x9A54 and 0x9A55 (v2.4.0, v2.5.258 and
+	// v2.6.3 freeze the same fields in the same order); only SPU2.bin differs.
+	state.source_format = static_cast<u16>(state.source_version >> 16);
+	const u16 native_format = static_cast<u16>(g_SaveVersion >> 16);
+	if (state.target_format == 0)
+		state.target_format = native_format;
+	const u16 source = state.source_format;
+	const u16 target = state.target_format;
+	const bool pre_9a54 = source == 0x9A4F || source == 0x9A50;
+	const bool supported = (target == native_format) ||
+						   (target == TargetFormat9A55 && source != 0x9A55) ||
+						   (target == TargetFormat9A54 && pre_9a54) ||
+						   (target == TargetFormat9A50 && source == 0x9A4F);
+	if (!supported)
+	{
+		Error::SetStringFmt(error, "No translation from 0x{:04X} to 0x{:04X}.", source, target);
+		return false;
+	}
+	report.Add("Legacy save state: format 0x{:04X}.{:04X}, build '{}' -> target format 0x{:04X}.0000",
+		state.source_version >> 16, state.source_version & 0xFFFF, state.source_build, target);
+
+	// Internal structures first: they provide the clock references for SPU2. Older streams are
+	// first brought to the 0x9A54 layout; the full 0x9A54 parse then validates every target.
+	std::optional<std::vector<u8>> internals = ReadEntry(zf, ENTRY_INTERNALS);
+	if (!internals.has_value())
+	{
+		Error::SetString(error, "Legacy state has no readable internal structures entry.");
+		return false;
+	}
+	std::vector<u8> layout54;
+	if (pre_9a54)
+	{
+		if (!UpgradeInternalsTo9A54(*internals, layout54, source, report, error))
+			return false;
+	}
+	else
+	{
+		layout54 = *internals;
+	}
+	std::vector<u8> converted;
+	if (!ConvertInternalStructures(layout54, converted, state.context, report, error))
+		return false;
+	if (target == TargetFormat9A55 || target == TargetFormat9A54)
+	{
+		report.Add("  0x{:04X} target: 0x9A54 stream layout kept", target);
+		converted = std::move(layout54);
+	}
+	else if (target == TargetFormat9A50)
+	{
+		// 0x9A4F -> 0x9A50 only added the host file handle section (empty here).
+		report.Add("  0x9A50 target: source stream kept, empty host file handle section appended");
+		converted = std::move(*internals);
+		char tag[32] = {};
+		StringUtil::Strlcpy(tag, "hostHandles", sizeof(tag));
+		const size_t none = 0;
+		converted.insert(converted.end(), reinterpret_cast<const u8*>(tag), reinterpret_cast<const u8*>(tag) + sizeof(tag));
+		converted.insert(converted.end(), reinterpret_cast<const u8*>(&none), reinterpret_cast<const u8*>(&none) + sizeof(none));
+	}
+	state.entries.push_back({ENTRY_INTERNALS, std::move(converted)});
+
+	for (const KnownEntry& known : s_entries)
+	{
+		std::optional<std::vector<u8>> data = ReadEntry(zf, known.name);
+		if (!data.has_value())
+		{
+			if (known.required)
+			{
+				Error::SetStringFmt(error, "Legacy state is missing required component {}.", known.name);
+				report.Add("{}: MISSING", known.name);
+				return false;
+			}
+			report.Add("{}: absent (optional)", known.name);
+			continue;
+		}
+
+		switch (known.kind)
+		{
+			case Kind::Memory:
+				if (data->size() != known.size_a && data->size() != known.size_b)
+				{
+					Error::SetStringFmt(error, "{} has unexpected size {}.", known.name, data->size());
+					return false;
+				}
+				report.Add("{}: {} bytes, raw memory image, copied", known.name, data->size());
+				break;
+
+			case Kind::SPU2:
+			{
+				// 0x9A4F and 0x9A50 use the 0x9A54 SPU2 block (same defs.h layout and SAVE_VERSION).
+				const u16 spu2_layout = pre_9a54 ? static_cast<u16>(0x9A54) : source;
+				std::vector<u8> spu2;
+				bool ok;
+				if (target == native_format)
+					ok = ConvertSPU2(*data, spu2, state.context, spu2_layout, report, error);
+				else if (target == TargetFormat9A55)
+					ok = ConvertSPU2To9A55(*data, spu2, report, error);
+				else
+				{
+					// 0x9A54/0x9A50 targets keep the block; check it is the expected layout.
+					std::vector<u8> scratch;
+					Report quiet;
+					quiet.echo_to_console = false;
+					ok = ConvertSPU2(*data, scratch, state.context, spu2_layout, quiet, error);
+					spu2 = *data;
+					if (ok)
+						report.Add("SPU2 ({} bytes): 0x9A54 layout, unchanged in the target format, copied", data->size());
+				}
+				if (!ok)
+					return false;
+				data = std::move(spu2);
+				break;
+			}
+
+			case Kind::Wrapper:
+				// Pad::Freeze / USB::DoState encodings are unchanged between v2.5.258 and v2.8.2.
+				if (!StartsWithMarker(*data, known.marker))
+				{
+					Error::SetStringFmt(error, "{} does not start with the '{}' marker.", known.name, known.marker);
+					return false;
+				}
+				report.Add("{}: {} bytes, '{}' StateWrapper stream, format unchanged, copied", known.name, data->size(),
+					known.marker);
+				break;
+
+			case Kind::GS:
+			{
+				// GSState::Freeze: STATE_VERSION 8 in 0x9A4F/0x9A50, 9 (identical layout) from 0x9A54
+				// to this build.
+				u32 gs_version = 0;
+				if (data->size() >= sizeof(u32))
+					std::memcpy(&gs_version, data->data(), sizeof(u32));
+				const u32 target_gs_version = (target == TargetFormat9A50) ? 8 : 9;
+				const size_t expected = (gs_version == 8) ? GS_STATE_V8_SIZE : GS_STATE_V9_SIZE;
+				if ((gs_version != 8 && gs_version != 9) || gs_version > target_gs_version || data->size() != expected)
+				{
+					Error::SetStringFmt(error, "GS.bin has unsupported renderer state version {} ({} bytes).", gs_version, data->size());
+					return false;
+				}
+				if (gs_version == target_gs_version)
+				{
+					report.Add("{}: {} bytes, GS state version {}, unchanged in the target format, copied", known.name, data->size(), gs_version);
+					break;
+				}
+				UpgradeGSState8To9(*data);
+				report.Add("{}: GS state version 8 -> 9 ({} -> {} bytes), transfer state set as GSState::Defrost derives it for version 8",
+					known.name, GS_STATE_V8_SIZE, data->size());
+				break;
+			}
+
+			case Kind::Optional:
+				report.Add("{}: {} bytes, copied", known.name, data->size());
+				break;
+		}
+
+		state.entries.push_back({known.name, std::move(*data)});
+	}
+
+	if (std::optional<std::vector<u8>> png = ReadEntry(zf, ENTRY_SCREENSHOT); png.has_value())
+		state.screenshot_png = std::move(*png);
+
+	// Report entries the native loader would not read.
+	const zip_int64_t count = zip_get_num_entries(zf, 0);
+	for (zip_int64_t i = 0; i < count; i++)
+	{
+		const char* name = zip_get_name(zf, static_cast<zip_uint64_t>(i), 0);
+		if (!name)
+			continue;
+		const bool known = std::strcmp(name, ENTRY_VERSION) == 0 || std::strcmp(name, ENTRY_SCREENSHOT) == 0 ||
+						   std::strcmp(name, ENTRY_INTERNALS) == 0 ||
+						   std::any_of(std::begin(s_entries), std::end(s_entries),
+							   [name](const KnownEntry& e) { return std::strcmp(e.name, name) == 0; });
+		if (!known)
+			report.Add("{}: not part of the target format, dropped", name);
+	}
+
+	report.Add("Conversion complete: all required components translated.");
+	return true;
+}
+
+bool SaveStateLegacy::WriteArchive(const ConvertedState& state, const char* output, Error* error)
+{
+	// FileSystem uses long (\\?\) paths on Windows, which do not accept '/' separators.
+	const std::string native = Path::Canonicalize(Path::ToNativePath(output));
+	const char* filename = native.c_str();
+	if (FileSystem::FileExists(filename))
+	{
+		Error::SetStringFmt(error, "Refusing to overwrite existing file '{}'.", native);
+		return false;
+	}
+
+	const std::string temp = fmt::format("{}.partial", native);
+	if (FileSystem::FileExists(temp.c_str()) && !FileSystem::DeleteFilePath(temp.c_str(), error))
+		return false;
+	zip_error_t ze = {};
+	zip_source_t* zs = zip_source_file_create(temp.c_str(), 0, 0, &ze);
+	zip_t* zf = zs ? zip_open_from_source(zs, ZIP_CREATE | ZIP_TRUNCATE, &ze) : nullptr;
+	if (!zf)
+	{
+		if (zs)
+			zip_source_free(zs);
+		Error::SetStringFmt(error, "Failed to create '{}': {}", temp, zip_error_strerror(&ze));
+		return false;
+	}
+
+	const VersionRecord version = MakeVersionRecord(state);
+	if (!AddEntries(zf, state, version, true, error))
+	{
+		zip_discard(zf);
+		FileSystem::DeleteFilePath(temp.c_str());
+		return false;
+	}
+	if (zip_close(zf) != 0)
+	{
+		Error::SetStringFmt(error, "Failed to write '{}': {}", temp, zip_strerror(zf));
+		zip_discard(zf);
+		FileSystem::DeleteFilePath(temp.c_str());
+		return false;
+	}
+	if (!FileSystem::RenamePath(temp.c_str(), filename, error))
+	{
+		FileSystem::DeleteFilePath(temp.c_str());
+		return false;
+	}
+	return true;
+}
+
+std::unique_ptr<zip_t, void (*)(zip_t*)> SaveStateLegacy::OpenAsNativeArchive(const ConvertedState& state, Error* error)
+{
+	auto discard = [](zip_t* zf) {
+		if (zf)
+			zip_discard(zf);
+	};
+	std::unique_ptr<zip_t, void (*)(zip_t*)> result(nullptr, discard);
+
+	zip_error_t ze = {};
+	zip_source_t* zs = zip_source_buffer_create(nullptr, 0, 0, &ze);
+	if (!zs)
+	{
+		Error::SetStringFmt(error, "Failed to create in-memory archive: {}", zip_error_strerror(&ze));
+		return result;
+	}
+	zip_source_keep(zs);
+
+	zip_t* writer = zip_open_from_source(zs, ZIP_TRUNCATE, &ze);
+	if (!writer)
+	{
+		zip_source_free(zs);
+		zip_source_free(zs);
+		Error::SetStringFmt(error, "Failed to open in-memory archive: {}", zip_error_strerror(&ze));
+		return result;
+	}
+	const VersionRecord version = MakeVersionRecord(state);
+	if (!AddEntries(writer, state, version, false, error) || zip_close(writer) != 0)
+	{
+		if (!error || !error->IsValid())
+			Error::SetStringFmt(error, "Failed to build in-memory archive: {}", zip_strerror(writer));
+		zip_discard(writer);
+		zip_source_free(zs);
+		return result;
+	}
+
+	zip_t* reader = zip_open_from_source(zs, ZIP_RDONLY, &ze);
+	if (!reader)
+	{
+		zip_source_free(zs);
+		Error::SetStringFmt(error, "Failed to reopen in-memory archive: {}", zip_error_strerror(&ze));
+		return result;
+	}
+	result.reset(reader);
+	return result;
+}
diff --git a/pcsx2/SaveStateLegacy.h b/pcsx2/SaveStateLegacy.h
new file mode 100644
index 000000000..b1169f593
--- /dev/null
+++ b/pcsx2/SaveStateLegacy.h
@@ -0,0 +1,145 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+// Experimental reader for save-state formats 0x9A4F (PCSX2 v2.0.x), 0x9A50 (v2.2.0), 0x9A54
+// (v2.4.0 and the v2.5.x development builds that preceded the 0x9A55 bump) and 0x9A55 (v2.6.x).
+// Every archive entry is translated into the native representation of this build (or of an
+// older stable target format) before any emulator state is touched. The translation is purely
+// data-to-data: nothing in this module reads or writes VM state, and it does not depend on
+// emulator code beyond type definitions.
+
+#pragma once
+
+#include "common/Pcsx2Defs.h"
+
+#include "fmt/format.h"
+
+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+class Error;
+typedef struct zip zip_t;
+
+namespace SaveStateLegacy
+{
+	// Source formats with a translation to this build's format: 0x9A4F (PCSX2 2.0.x),
+	// 0x9A50 (2.2.0), 0x9A54 (2.4.0 and the 2.5.x development builds), 0x9A55 (2.6.x).
+	static constexpr u16 SourceFormats[] = {0x9A4F, 0x9A50, 0x9A54, 0x9A55};
+
+	struct Report
+	{
+		std::vector<std::string> lines;
+		bool echo_to_console = true;
+
+		void Add(std::string line);
+
+		template <typename... T>
+		void Add(fmt::format_string<T...> format, T&&... args)
+		{
+			Add(fmt::format(format, std::forward<T>(args)...));
+		}
+	};
+
+	// Maps a 32-bit cycle counter domain onto the 64-bit counters used since 0x9A58.
+	// The legacy counters wrap every 2^32 cycles (about 14.6 s of EE time and 116 s of
+	// IOP time), so zero-extension would turn timestamps captured before a wrap into
+	// far-future values. Instead, the reference counter is placed at 2^32 + now and
+	// every other timestamp keeps its modular distance from the reference. The low 32 bits
+	// of every value, and every difference between values, are preserved exactly.
+	struct CycleDomain
+	{
+		static constexpr u64 Epoch = u64{1} << 32;
+
+		u32 now32 = 0;
+		u64 now64 = 0;
+		// Number of live Past() timestamps that predate a 32-bit wrap of the reference counter.
+		// Zero-extension would have placed each of them roughly 2^32 cycles in the future.
+		// Inactive slots (e.g. interrupts that are not pending) go through PastInactive().
+		mutable u32 wrapped = 0;
+
+		void Set(u32 now)
+		{
+			now32 = now;
+			now64 = Epoch + now;
+		}
+
+		// A timestamp taken at or before the reference point (at most 2^32-1 cycles ago).
+		u64 Past(u32 value) const
+		{
+			if (value > now32)
+				wrapped++;
+			return now64 - static_cast<u32>(now32 - value);
+		}
+
+		// Same mapping for a slot whose value is not currently in use; not counted.
+		u64 PastInactive(u32 value) const { return now64 - static_cast<u32>(now32 - value); }
+
+		// A timestamp within +/-2^31 cycles of the reference point (event deadlines etc.).
+		u64 Near(u32 value) const { return now64 + static_cast<s64>(static_cast<s32>(value - now32)); }
+
+		// Same as Near(), against a different (already converted) reference value.
+		static u64 NearTo(u64 ref64, u32 ref32, u32 value)
+		{
+			return ref64 + static_cast<s64>(static_cast<s32>(value - ref32));
+		}
+	};
+
+	struct Context
+	{
+		CycleDomain ee;
+		CycleDomain iop;
+		bool cycles_known = false;
+	};
+
+	struct Entry
+	{
+		std::string name;
+		std::vector<u8> data;
+	};
+
+	// Formats this module can write (forward only): this build's own format (0x9A59) from every
+	// source; 0x9A55 (2.6.x) from 0x9A4F/0x9A50/0x9A54; 0x9A54 (2.4.0) from 0x9A4F/0x9A50;
+	// 0x9A50 (2.2.0) from 0x9A4F.
+	static constexpr u16 TargetFormat9A55 = 0x9A55;
+	static constexpr u16 TargetFormat9A54 = 0x9A54;
+	static constexpr u16 TargetFormat9A50 = 0x9A50;
+
+	struct ConvertedState
+	{
+		// Requested output format; 0 selects this build's own format. Set before ConvertArchive().
+		u16 target_format = 0;
+		u32 source_version = 0;
+		u16 source_format = 0;
+		std::string source_build;
+		Context context;
+		// "PCSX2 Internal Structures.dat" first, followed by the component entries.
+		std::vector<Entry> entries;
+		std::vector<u8> screenshot_png;
+		Report report;
+	};
+
+	bool IsLegacyVersion(u32 savever);
+
+	// Pure in-memory conversions of individual archive entries.
+	// 0x9A54/0x9A55 Internal Structures -> this build's layout.
+	bool ConvertInternalStructures(std::span<const u8> src, std::vector<u8>& dst, Context& ctx, Report& report, Error* error);
+	// 0x9A4F/0x9A50 Internal Structures -> the 0x9A54 layout (TLB rewrite, cached TLB list,
+	// SIO2 busy-frame field, host file handle section).
+	bool UpgradeInternalsTo9A54(std::span<const u8> src, std::vector<u8>& dst, u16 source_format, Report& report, Error* error);
+	bool ConvertSPU2(std::span<const u8> src, std::vector<u8>& dst, const Context& ctx, u16 source_format, Report& report, Error* error);
+
+	// Size of the SPU2 block this module produces (must equal SPU2Savestate::SizeIt()).
+	size_t TargetSPU2Size();
+
+	// Reads and converts a complete legacy archive. Fails without partial output if any
+	// required component cannot be translated and validated.
+	bool ConvertArchive(zip_t* zf, ConvertedState* out, Error* error);
+
+	// Serializes a converted state as a native archive on disk.
+	bool WriteArchive(const ConvertedState& state, const char* filename, Error* error);
+
+	// Builds a native archive in memory (stored, uncompressed) for the standard loader.
+	std::unique_ptr<zip_t, void (*)(zip_t*)> OpenAsNativeArchive(const ConvertedState& state, Error* error);
+} // namespace SaveStateLegacy
