+// GSState::Freeze (GS/GSState.cpp). Version 8 (0x9A4F/0x9A50): version, 15 GIFRegs (PRIM ..
+// TRXREG and an obsolete second TRXREG), 2 contexts x 12 GIFRegs, RGBAQ, ST (8 each), UV, FOG
+// (4 each), XYZ (8), an obsolete GIFReg, m_tr.x, m_tr.y, local memory (4 MiB), 4 x (GIFTag,
+// u32 reg), m_q. Version 9 (0x9A54 to this build) inserts the transfer state after m_tr.y.
+static constexpr size_t GS_OFS_BITBLTBUF = 4 + 10 * 8;
+static constexpr size_t GS_OFS_TRXPOS = 4 + 12 * 8;
+static constexpr size_t GS_OFS_TRXREG_KEPT = 4 + 14 * 8; // Defrost reads TRXREG twice; the second copy stays
+static constexpr size_t GS_OFS_TRANSFER = 4 + 15 * 8 + 2 * 12 * 8 + 32 + 8 + 2 * 4;
+static constexpr size_t GS_LOCAL_MEMORY_SIZE = 4 * 1024 * 1024;
+static constexpr size_t GS_STATE_V8_SIZE = GS_OFS_TRANSFER + GS_LOCAL_MEMORY_SIZE + 4 * (16 + 4) + 4;
+
+#pragma pack(push, 1)
+struct GSTransferV9 // m_tr.w, h, m_blit, m_pos, m_reg, rect, total, start, end, write
+{
+	s32 w, h;
+	u64 blit, pos, reg;
+	s32 rect[4];
+	s32 total, start, end;
+	u8 write;
+};
+#pragma pack(pop)
+static_assert(sizeof(GSTransferV9) == 61);
+static constexpr size_t GS_STATE_V9_SIZE = GS_STATE_V8_SIZE + sizeof(GSTransferV9);
+static_assert(GS_OFS_TRANSFER == 364 && GS_STATE_V8_SIZE == 4194752 && GS_STATE_V9_SIZE == 4194813);
+
+// The target's component loader reads exactly GetSaveStateSize(9) bytes from GS.bin, so version 8
+// data cannot be passed through although GSState::Defrost understands it. The inserted transfer
+// state is the one Defrost derives for version 8 data ("assume the last transfer was a write (but
+// nuke it)"), so the loaded GS state is identical to a native version 8 load.
+static void UpgradeGSState8To9(std::vector<u8>& gs)
+{
+	u64 blit, pos, reg;
+	std::memcpy(&blit, gs.data() + GS_OFS_BITBLTBUF, sizeof(blit));
+	std::memcpy(&pos, gs.data() + GS_OFS_TRXPOS, sizeof(pos));
+	std::memcpy(&reg, gs.data() + GS_OFS_TRXREG_KEPT, sizeof(reg));
+
+	GSTransferV9 tr = {};
+	tr.w = static_cast<s32>(reg & 0xFFF); // TRXREG.RRW
+	tr.h = static_cast<s32>((reg >> 32) & 0xFFF); // TRXREG.RRH
+	tr.blit = blit;
+	tr.pos = pos;
+	tr.reg = reg;
+	const s32 dsax = static_cast<s32>((pos >> 32) & 0x7FF); // TRXPOS.DSAX
+	const s32 dsay = static_cast<s32>((pos >> 48) & 0x7FF); // TRXPOS.DSAY
+	tr.rect[0] = dsax;
+	tr.rect[1] = dsay;
+	tr.rect[2] = dsax + tr.w;
+	tr.rect[3] = dsay + tr.h;
+	tr.write = 1;
+
+	const u32 version = 9;
+	std::memcpy(gs.data(), &version, sizeof(version));
+	const u8* bytes = reinterpret_cast<const u8*>(&tr);
+	gs.insert(gs.begin() + GS_OFS_TRANSFER, bytes, bytes + sizeof(tr));
+}
+
+// 0x9A54 -> 0x9A55 (PCSX2 2.6.x). Both use the fetch/interpolation mixer, so voices keep their
+// playback state; 0x9A55 drops the deferred loop-start fields (resolved with the legacy rule)
+// and adds a pending KeyOff mask. Clocks stay 32-bit.
+static bool ConvertSPU2To9A55(std::span<const u8> src, std::vector<u8>& dst, Report& report, Error* error)
+{
+	auto fail = [&](std::string_view what) {
+		const std::string message = fmt::format("Legacy 0x9A54 SPU2 -> 0x9A55: {}.", what);
+		report.Add(message);
+		Error::SetString(error, message);
+		return false;
+	};
+
+	report.Add("SPU2 ({} bytes, 0x9A54 layout) -> 0x9A55 layout:", src.size());
+	if (src.size() != sizeof(Legacy::DataBlock9A54))
+		return fail(fmt::format("size {} does not match the 0x9A54 layout", src.size()));
+
+	auto o = std::make_unique<Legacy::DataBlock9A54>();
+	std::memcpy(static_cast<void*>(o.get()), src.data(), sizeof(Legacy::DataBlock9A54));
+	if (o->spu2id != SPU2_SAVE_ID || o->version != SPU2_SAVE_VERSION)
+		return fail(fmt::format("unexpected identifier {:08X}/version {:04X}", o->spu2id, o->version));
+
+	auto n = std::make_unique<Legacy::DataBlock9A55>();
+	std::memset(static_cast<void*>(n.get()), 0, sizeof(Legacy::DataBlock9A55));
+	n->spu2id = o->spu2id;
+	std::memcpy(n->unkregs, o->unkregs, sizeof(n->unkregs));
+	std::memcpy(n->mem, o->mem, sizeof(n->mem));
+	n->version = o->version;
+
+	int applied = 0, dropped = 0;
+	for (int c = 0; c < 2; c++)
+	{
+		const Legacy::V_Core9A54& oc = o->Cores[c];
+		Legacy::V_Core9A55& nc = n->Cores[c];
+		std::memcpy(static_cast<void*>(&nc), &oc, offsetof(Legacy::V_Core9A55, Voices));
+
+		for (int i = 0; i < V_Core::NumVoices; i++)
+		{
+			const Legacy::V_Voice9A54& ov = oc.Voices[i];
+			Legacy::V_Voice9A55& nv = nc.Voices[i];
+			nv.Volume = ov.Volume;
+			nv.ADSR = ov.ADSR;
+			nv.Pitch = ov.Pitch;
+			nv.LoopStartA = ov.LoopStartA;
+			nv.StartA = ov.StartA;
+			nv.NextA = ov.NextA;
+			nv.Prev1 = ov.Prev1;
+			nv.Prev2 = ov.Prev2;
+			nv.Modulated = ov.Modulated;
+			nv.Noise = ov.Noise;
+			nv.LoopMode = ov.LoopMode;
+			nv.LoopFlags = ov.LoopFlags;
+			nv.SP = ov.SP;
+			nv.SPc = ov.SPc;
+			nv.PV4 = ov.PV4;
+			nv.PV3 = ov.PV3;
+			nv.PV2 = ov.PV2;
+			nv.PV1 = ov.PV1;
+			nv.OutX = ov.OutX;
+			nv.NextCrest = ov.NextCrest;
+			nv.SBuffer = nullptr; // recomputed from NextA by ThawIt()
+			nv.SCurrent = ov.SCurrent;
+			if (ov.PendingLoopStart)
+			{
+				if (static_cast<s32>(ov.LoopCycle - ov.PlayCycle) < 0)
+				{
+					nv.LoopStartA = ov.PendingLoopStartA;
+					nv.LoopMode = 1;
+					applied++;
+				}
+				else
+				{
+					dropped++;
+				}
+			}
+		}
+
+		nc.IRQA = oc.IRQA;
+		nc.TSA = oc.TSA;
+		nc.ActiveTSA = oc.ActiveTSA;
+		nc.IRQEnable = oc.IRQEnable;
+		nc.FxEnable = oc.FxEnable;
+		nc.Mute = oc.Mute;
+		nc.AdmaInProgress = oc.AdmaInProgress;
+		nc.DMABits = oc.DMABits;
+		nc.NoiseClk = oc.NoiseClk;
+		nc.NoiseCnt = oc.NoiseCnt;
+		nc.NoiseOut = oc.NoiseOut;
+		nc.AutoDMACtrl = oc.AutoDMACtrl;
+		nc.DMAICounter = oc.DMAICounter;
+		nc.LastClock = oc.LastClock;
+		nc.InputDataLeft = oc.InputDataLeft;
+		nc.InputDataTransferred = oc.InputDataTransferred;
+		nc.InputPosWrite = oc.InputPosWrite;
+		nc.InputDataProgress = oc.InputDataProgress;
+		nc.Revb = oc.Revb;
+		std::memcpy(nc.RevbDownBuf, oc.RevbDownBuf, sizeof(nc.RevbDownBuf));
+		std::memcpy(nc.RevbUpBuf, oc.RevbUpBuf, sizeof(nc.RevbUpBuf));
+		nc.RevbSampleBufPos = oc.RevbSampleBufPos;
+		nc.EffectsStartA = oc.EffectsStartA;
+		nc.EffectsEndA = oc.EffectsEndA;
+		nc.Regs = oc.Regs;
+		nc.LastEffect = oc.LastEffect;
+		nc.CoreEnabled = oc.CoreEnabled;
+		nc.AttrBit0 = oc.AttrBit0;
+		nc.DmaMode = oc.DmaMode;
+		nc.DmaStarted = oc.DmaStarted;
+		nc.AutoDmaFree = oc.AutoDmaFree;
+		nc.DMAPtr = oc.DMAPtr;
+		nc.DMARPtr = oc.DMARPtr;
+		nc.ReadSize = oc.ReadSize;
+		nc.IsDMARead = oc.IsDMARead;
+		nc.KeyOn = oc.KeyOn; // queued key-ons start on the next tick (see ConvertSPU2Block)
+		nc.KeyOff = 0;
+		nc.psxSoundDataTransferControl = oc.psxSoundDataTransferControl;
+		nc.psxSPUSTAT = oc.psxSPUSTAT;
+	}
+
+	std::memcpy(static_cast<void*>(&n->Spdif), &o->Spdif, sizeof(V_SPDIF));
+	n->OutPos = o->OutPos;
+	n->InputPos = o->InputPos;
+	n->Cycles = o->Cycles;
+	n->lClocks = o->lClocks;
+	n->PlayMode = o->PlayMode;
+
+	if (applied || dropped)
+		report.Add("  deferred loop-start writes: {} applied, {} superseded by waveform loop flags", applied, dropped);
+	report.Add("  complete: {} -> {} bytes (voice playback state carried over)", src.size(), sizeof(Legacy::DataBlock9A55));
+	const u8* bytes = reinterpret_cast<const u8*>(n.get());
+	dst.assign(bytes, bytes + sizeof(Legacy::DataBlock9A55));
+	return true;
+}
+} // namespace
+
+bool SaveStateLegacy::ConvertSPU2(std::span<const u8> src, std::vector<u8>& dst, const Context& ctx, u16 source_format, Report& report, Error* error)
+{
+	switch (source_format)
+	{
+		case 0x9A54:
+			return ConvertSPU2Block<Legacy::DataBlock9A54>(src, dst, ctx, source_format, report, error);
+		case 0x9A55:
+			return ConvertSPU2Block<Legacy::DataBlock9A55>(src, dst, ctx, source_format, report, error);
+		default:
+			Error::SetStringFmt(error, "No SPU2 schema for format 0x{:04X}.", source_format);
+			return false;
+	}
+}
