+
+// Target-side layout facts this translation depends on.
+static_assert(sizeof(cpuRegisters) == 1160 && offsetof(cpuRegisters, sCycle) == 832 &&
+			  offsetof(cpuRegisters, cycle) == 1088 && offsetof(cpuRegisters, nextEventCycle) == 1120);
+static_assert(offsetof(cpuRegisters, eCycle) == offsetof(Legacy::cpuRegisters, eCycle));
+static_assert(sizeof(psxRegisters) == 952 && offsetof(psxRegisters, cycle) == 528 && offsetof(psxRegisters, sCycle) == 568);
+static_assert(sizeof(Counter) == 32 && sizeof(SyncCounter) == 24 && sizeof(psxCounter) == 48);
+static_assert(sizeof(fdivPipe) == 40 && sizeof(efuPipe) == 40 && sizeof(fmacPipe) == 48 && sizeof(ialuPipe) == 24);
+static_assert(sizeof(V_Voice) == 264 && sizeof(V_Core) == 8128);
+static_assert(sizeof(tlbs) == 16 && sizeof(cachedTlbs_t) == 976 && std::size(tlb) == 48);
+static_assert(offsetof(V_Core, Voices) == offsetof(Legacy::V_Core9A54, Voices) &&
+			  offsetof(V_Core, Voices) == offsetof(Legacy::V_Core9A55, Voices));
+static_assert(std::is_same_v<decltype(EEoCycle), u64> && std::is_same_v<decltype(nextStartCounter), u64> &&
+			  std::is_same_v<decltype(psxNextStartCounter), u64>);
+static_assert(std::is_same_v<decltype(EEsCycle), s32> && std::is_same_v<decltype(nextDeltaCounter), s32> &&
+			  std::is_same_v<decltype(psxNextDeltaCounter), s32>);
+
+namespace
+{
+	static constexpr u32 SPU2_SAVE_ID = 0x1227521; // SPU2Savestate::SAVE_ID
+	static constexpr u32 SPU2_SAVE_VERSION = 0x000e; // SPU2Savestate::SAVE_VERSION (same in both formats)
+
+	// pcsx2/SPU2/Mixer.cpp
+	static constexpr int XAFLAG_LOOP_END = 1 << 0;
+
+	// Sizes of file-local (static) variables that cannot be named from this translation unit.
+	// Each is followed in the stream by a tag or a validated structure, which catches drift.
+	static constexpr size_t VSYNC_TIMING_INFO_SIZE = 40; // Counters.cpp: vSyncTimingInfo (double, int enum, 7 x u32)
+	// Memory.cpp: u16 s_ba[0xff], u16 s_dve_regs[0xff], bool s_ba_command_executing,
+	// bool s_ba_error_detected, u16 s_ba_current_reg, bool extra_memory.
+	static constexpr size_t MEMORY_FREEZE_SIZE = 2 * 0xff * sizeof(u16) + 2 * sizeof(bool) + sizeof(u16) + sizeof(bool);
+	static_assert(MEMORY_FREEZE_SIZE == 1025);
+	// x86/microVU_IR.h: static_assert(sizeof(microRegInfo) == 96); the header defines microVU0/1
+	// and cannot be included here. vuJITFreeze writes microVU0/1.prog.lpState.
+	static constexpr size_t MICRO_REG_INFO_SIZE = 96;
+	static constexpr size_t SPR_FREEZE_SIZE = sizeof(bool) * 2 + sizeof(u32); // SPR.cpp: spr0finished, spr1finished, mfifotransferred
+	static constexpr size_t DECI2_FREEZE_SIZE = sizeof(u32) * 2 + 256; // R5900OpcodeImpl.cpp: deci2addr, deci2handler, deci2buffer
+
+	// Sequential reader of the legacy stream with a parallel writer for the target stream.
+	class Translator
+	{
+	public:
+		Translator(std::span<const u8> src, std::vector<u8>& dst, Report& report)
+			: m_src(src)
+			, m_dst(dst)
+			, m_report(report)
+		{
+		}
+
+		size_t Pos() const { return m_pos; }
+		size_t OutPos() const { return m_dst.size(); }
+		size_t Remaining() const { return m_src.size() - m_pos; }
+
+		const u8* Peek(size_t count) const { return (count <= Remaining()) ? (m_src.data() + m_pos) : nullptr; }
+
+		bool Take(void* out, size_t count)
+		{
+			if (count > Remaining())
+				return false;
+			std::memcpy(out, m_src.data() + m_pos, count);
+			m_pos += count;
+			return true;
+		}
+
+		template <typename T>
+		bool Read(T& value)
+		{
+			return Take(&value, sizeof(T));
+		}
+
+		void Put(const void* data, size_t count)
+		{
+			const u8* bytes = static_cast<const u8*>(data);
+			m_dst.insert(m_dst.end(), bytes, bytes + count);
+		}
+
+		template <typename T>
+		void Write(const T& value)
+		{
+			Put(&value, sizeof(T));
+		}
+
+		bool Copy(size_t count)
+		{
+			if (count > Remaining())
+				return false;
+			Put(m_src.data() + m_pos, count);
+			m_pos += count;
+			return true;
+		}
+
+		bool Tag(const char* name)
+		{
+			char expected[32] = {};
+			StringUtil::Strlcpy(expected, name, sizeof(expected));
+			const u8* actual = Peek(sizeof(expected));
+			if (!actual || std::memcmp(actual, expected, sizeof(expected)) != 0)
+				return false;
+			return Copy(sizeof(expected));
+		}
+
+		void Section(const char* name, size_t src_start, size_t dst_start, const char* action)
+		{
+			m_report.Add("  {:<28} source {:>8} +{:<7} target {:>8} +{:<7} {}", name, src_start, m_pos - src_start,
+				dst_start, m_dst.size() - dst_start, action);
+		}
+
+	private:
+		std::span<const u8> m_src;
+		size_t m_pos = 0;
+		std::vector<u8>& m_dst;
+		Report& m_report;
+	};
+
+	// Walks a StateWrapper-encoded region without interpreting it, to find its length.
+	class WrapperWalker
+	{
+	public:
+		WrapperWalker(const u8* data, size_t size)
+			: m_data(data)
+			, m_size(size)
+		{
+		}
+
+		bool Skip(size_t count)
+		{
+			if (count > m_size - m_pos)
+				return false;
+			m_pos += count;
+			return true;
+		}
+
+		bool U32(u32* value)
+		{
+			if (sizeof(u32) > m_size - m_pos)
+				return false;
+			std::memcpy(value, m_data + m_pos, sizeof(u32));
+			m_pos += sizeof(u32);
+			return true;
+		}
+
+		bool Marker(const char* name)
+		{
+			u32 length;
+			if (!U32(&length) || length != std::strlen(name) || length > m_size - m_pos)
+				return false;
+			if (std::memcmp(m_data + m_pos, name, length) != 0)
+				return false;
+			m_pos += length;
+			return true;
+		}
+
+		bool ByteDeque(size_t limit)
+		{
+			u32 length;
+			return U32(&length) && length <= limit && Skip(length);
+		}
+
+		size_t Pos() const { return m_pos; }
+
+	private:
+		const u8* m_data;
+		size_t m_size;
+		size_t m_pos = 0;
+	};
+
+	template <typename T>
+	constexpr size_t SizeOf()
+	{
+		if constexpr (std::is_same_v<T, bool>)
+			return 1; // StateWrapper::Do(bool*) writes one byte.
+		else if constexpr (std::is_enum_v<T>)
+			return sizeof(std::underlying_type_t<T>);
+		else
+			return sizeof(T);
+	}
+
+	static void ConvertCpuRegisters(const Legacy::cpuRegisters& o, cpuRegisters& n, const CycleDomain& ee)
+	{
+		std::memset(&n, 0, sizeof(n));
+		n.GPR = o.GPR;
+		n.HI = o.HI;
+		n.LO = o.LO;
+		n.CP0 = o.CP0;
+		n.sa = o.sa;
+		n.IsDelaySlot = o.IsDelaySlot;
+		n.pc = o.pc;
+		n.code = o.code;
+		n.PERF = o.PERF;
+		std::memcpy(n.eCycle, o.eCycle, sizeof(n.eCycle));
+		for (size_t i = 0; i < std::size(n.sCycle); i++)
+			n.sCycle[i] = ((o.interrupt >> i) & 1) ? ee.Past(o.sCycle[i]) : ee.PastInactive(o.sCycle[i]);
+		n.cycle = ee.now64;
+		n.interrupt = o.interrupt;
+		n.branch = o.branch;
+		n.opmode = o.opmode;
+		n.tempcycles = o.tempcycles;
+		n.dmastall = o.dmastall;
+		n.pcWriteback = o.pcWriteback;
+		n.nextEventCycle = ee.Near(o.nextEventCycle);
+		n.lastEventCycle = ee.Past(o.lastEventCycle);
+		n.lastCOP0Cycle = ee.Past(o.lastCOP0Cycle);
+		n.lastPERFCycle[0] = ee.Past(o.lastPERFCycle[0]);
+		n.lastPERFCycle[1] = ee.Past(o.lastPERFCycle[1]);
+	}
+
+	// COP0.cpp (0x9A54+): page mask -> address mask used by the EE cache lookup.
+	static u32 ConvertPageMask(u32 page_mask)
+	{
+		const u32 bits = static_cast<u32>(std::popcount(page_mask >> 13));
+		return (1u << (12 + bits)) - 1;
+	}
+
+	// 0x9A54 keeps only the raw TLB registers and serializes a list of the cached mappings
+	// (cachedTlbs). Rebuild each entry and the list exactly as WriteTLB() (COP0.cpp, v2.4.0+)
+	// does when the game writes an entry: scratchpad entries become cached, reserved cache
+	// modes become uncached, and every valid cached non-scratchpad entry gets one record.
+	static void UpgradeTlb(const Legacy::tlbs9A50* o, tlbs* n, cachedTlbs_t& cache, int* normalized)
+	{
+		std::memset(static_cast<void*>(&cache), 0, sizeof(cache));
+		*normalized = 0;
+		for (size_t i = 0; i < std::size(tlb); i++)
+		{
+			tlbs& e = n[i];
+			std::memset(static_cast<void*>(&e), 0, sizeof(e));
+			e.PageMask.UL = o[i].PageMask;
+			e.EntryHi.UL = o[i].EntryHi;
+			e.EntryLo0.UL = o[i].EntryLo0;
+			e.EntryLo1.UL = o[i].EntryLo1;
+
+			const u32 lo0 = e.EntryLo0.UL, lo1 = e.EntryLo1.UL;
+			if (e.isSPR())
+			{
+				e.EntryLo0.C = 3;
+				e.EntryLo1.C = 3;
+			}
+			else
+			{
+				if (!e.EntryLo0.isValidCacheMode())
+					e.EntryLo0.C = 2;
+				if (!e.EntryLo1.isValidCacheMode())
+					e.EntryLo1.C = 2;
+			}
+			if (e.EntryLo0.UL != lo0 || e.EntryLo1.UL != lo1)
+				(*normalized)++;
+
+			if (!e.isSPR() && ((e.EntryLo0.V && e.EntryLo0.isCached()) || (e.EntryLo1.V && e.EntryLo1.isCached())))
+			{
+				const size_t idx = cache.count;
+				cache.CacheEnabled0[idx] = e.EntryLo0.isCached() ? ~0u : 0u;
+				cache.CacheEnabled1[idx] = e.EntryLo1.isCached() ? ~0u : 0u;
+				cache.PFN1s[idx] = e.PFN1();
+				cache.PFN0s[idx] = e.PFN0();
+				cache.PageMasks[idx] = ConvertPageMask(e.PageMask.UL);
+				cache.count++;
+			}
+		}
+	}
+
+	static void ConvertPsxRegisters(const Legacy::psxRegisters& o, psxRegisters& n, const CycleDomain& iop)
+	{
+		std::memset(&n, 0, sizeof(n));
+		n.GPR = o.GPR;
+		n.CP0 = o.CP0;
+		n.CP2D = o.CP2D;
+		n.CP2C = o.CP2C;
+		n.pc = o.pc;
+		n.code = o.code;
+		n.cycle = iop.now64;
+		n.interrupt = o.interrupt;
+		n.pcWriteback = o.pcWriteback;
+		n.iopNextEventCycle = iop.Near(o.iopNextEventCycle);
+		n.iopBreak = o.iopBreak;
+		n.iopCycleEE = o.iopCycleEE;
+		n.iopCycleEECarry = o.iopCycleEECarry;
+		for (size_t i = 0; i < std::size(n.sCycle); i++)
+			n.sCycle[i] = ((o.interrupt >> i) & 1) ? iop.Past(o.sCycle[i]) : iop.PastInactive(o.sCycle[i]);
+		std::memcpy(n.eCycle, o.eCycle, sizeof(n.eCycle));
+	}
+
+	// Translates one VU's portion of vuMicroFreeze (VUmicroMem.cpp). The freeze order is
+	// identical at v2.4.0, v2.5.258 and v2.8.2; only the field widths differ.
+	static bool ConvertVuMicro(Translator& t, bool vu1, const CycleDomain& ee)
+	{
+		auto copy = [&](size_t size) { return t.Copy(size); };
+#define COPY_FIELD(member) \
+	if (!copy(sizeof(VURegs::member))) \
+		return false;
+
+		COPY_FIELD(ACC);
+		COPY_FIELD(VF);
+		COPY_FIELD(VI);
+		COPY_FIELD(q);
+		if (vu1)
+			COPY_FIELD(p);
+
+		u32 cycle32;
+		if (!t.Read(cycle32))
+			return false;
+		// VU time runs on the EE clock and may be slightly ahead of or behind the EE.
+		const u64 cycle64 = ee.Near(cycle32);
+		t.Write(static_cast<decltype(VURegs::cycle)>(cycle64));
+
+		COPY_FIELD(flags);
+		COPY_FIELD(code);
+		COPY_FIELD(start_pc);
+		COPY_FIELD(branch);
+		COPY_FIELD(branchpc);
+		COPY_FIELD(delaybranchpc);
+		COPY_FIELD(takedelaybranch);
+		COPY_FIELD(ebit);
+		COPY_FIELD(pending_q);
+		COPY_FIELD(pending_p);
+		COPY_FIELD(micro_macflags);
+		COPY_FIELD(micro_clipflags);
+		COPY_FIELD(micro_statusflags);
+		COPY_FIELD(macflag);
+		COPY_FIELD(statusflag);
+		COPY_FIELD(clipflag);
+
+		// A cycle count (not a timestamp): sign-extend.
+		s32 next_block_cycles;
+		if (!t.Read(next_block_cycles))
+			return false;
+		t.Write(static_cast<decltype(VURegs::nextBlockCycles)>(next_block_cycles));
+
+		if (vu1)
+		{
+			COPY_FIELD(xgkickaddr);
+			COPY_FIELD(xgkickdiff);
+			COPY_FIELD(xgkicksizeremaining);
+			u32 xgkick_last32;
+			if (!t.Read(xgkick_last32))
+				return false;
+			t.Write(static_cast<decltype(VURegs::xgkicklastcycle)>(ee.Near(xgkick_last32)));
+			COPY_FIELD(xgkickcyclecount);
+			COPY_FIELD(xgkickenable);
+			COPY_FIELD(xgkickendpacket);
+		}
+
+		COPY_FIELD(VIBackupCycles);
+		COPY_FIELD(VIOldValue);
+		COPY_FIELD(VIRegNumber);
+
+		// Pipeline start cycles are relative to this VU's own cycle counter.
+		auto pipe_cycle = [&](u32 value) { return CycleDomain::NearTo(cycle64, cycle32, value); };
+
+		for (size_t i = 0; i < std::extent_v<decltype(VURegs::fmac)>; i++)
+		{
+			Legacy::fmacPipe o;
+			if (!t.Read(o))
+				return false;
+			fmacPipe n = {};
+			n.regupper = o.regupper;
+			n.reglower = o.reglower;
+			n.flagreg = o.flagreg;
+			n.xyzwupper = o.xyzwupper;
+			n.xyzwlower = o.xyzwlower;
+			n.sCycle = pipe_cycle(o.sCycle);
+			n.Cycle = o.Cycle;
+			n.macflag = o.macflag;
+			n.statusflag = o.statusflag;
+			n.clipflag = o.clipflag;
+			t.Write(n);
+		}
+		COPY_FIELD(fmacreadpos);
+		COPY_FIELD(fmacwritepos);
+		COPY_FIELD(fmaccount);
+
+		{
+			Legacy::fdivPipe o;
+			if (!t.Read(o))
+				return false;
+			fdivPipe n = {};
+			n.enable = o.enable;
+			n.reg = o.reg;
+			n.sCycle = pipe_cycle(o.sCycle);
+			n.Cycle = o.Cycle;
+			n.statusflag = o.statusflag;
+			t.Write(n);
+		}
+		{
+			Legacy::efuPipe o;
+			if (!t.Read(o))
+				return false;
+			efuPipe n = {};
+			n.enable = o.enable;
+			n.reg = o.reg;
+			n.sCycle = pipe_cycle(o.sCycle);
+			n.Cycle = o.Cycle;
+			t.Write(n);
+		}
+		for (size_t i = 0; i < std::extent_v<decltype(VURegs::ialu)>; i++)
+		{
+			Legacy::ialuPipe o;
+			if (!t.Read(o))
+				return false;
+			ialuPipe n = {};
+			n.reg = o.reg;
+			n.sCycle = pipe_cycle(o.sCycle);
+			n.Cycle = o.Cycle;
+			t.Write(n);
+		}
+		COPY_FIELD(ialureadpos);
+		COPY_FIELD(ialuwritepos);
+		COPY_FIELD(ialucount);
+#undef COPY_FIELD
+		return true;
+	}
+} // namespace
+
+void SaveStateLegacy::Report::Add(std::string line)
+{
+	if (echo_to_console)
+		Console.WriteLn(line);
+	lines.push_back(std::move(line));
+}
+
+bool SaveStateLegacy::IsLegacyVersion(u32 savever)
+{
+	return std::find(std::begin(SourceFormats), std::end(SourceFormats), static_cast<u16>(savever >> 16)) !=
+		   std::end(SourceFormats);
+}
+
+// Walks a legacy Internal Structures stream section by section.
+//   widen = true : 0x9A54/0x9A55 stream -> this build's layout (64-bit cycle counters).
+//   widen = false: 0x9A4F/0x9A50 stream -> 0x9A54 layout (cycle fields copied unchanged).
+// format is the layout of `src`; the pre-0x9A54 differences are handled where they occur.
+static bool TranslateInternals(std::span<const u8> src, std::vector<u8>& dst, Context& ctx, Report& report, Error* error,
+	u16 format, bool widen)
+{
+	dst.clear();
+	dst.reserve(src.size() + 4096);
+	Translator t(src, dst, report);
+	const bool pre_9a54 = format < 0x9A54;
+
+	auto fail = [&](std::string_view what) {
+		const std::string message = fmt::format("Legacy Internal Structures: {} at source offset {}.", what, t.Pos());
+		report.Add(message);
+		Error::SetString(error, message);
+		return false;
+	};
+
+	if (widen)
+		report.Add("Internal Structures ({} bytes):", src.size());
+	else
+		report.Add("Internal Structures ({} bytes, 0x{:04X}) -> 0x9A54 layout:", src.size(), format);
+	size_t s0, d0;
+
+	// --- SaveStateBase::FreezeBios -----------------------------------------------------
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Tag("BIOS"))
+		return fail("missing BIOS tag");
+	if (!t.Copy(sizeof(u32) + 256))
+		return fail("truncated BIOS record");
+	t.Section("BIOS", s0, d0, "copied");
+
+	// --- SaveStateBase::vmFreeze (VMManager.cpp) ----------------------------------------
+	s0 = t.Pos(), d0 = t.OutPos();
+	{
+		u32 crc, length;
+		if (!t.Read(crc) || !t.Read(length))
+			return fail("truncated VM metadata");
+		const u8* text = t.Peek(static_cast<size_t>(length) + 1);
+		if (!text || text[length] > 1)
+			return fail("invalid ELF path record");
+		t.Write(crc);
+		t.Write(length);
+		t.Copy(static_cast<size_t>(length) + 1);
+		report.Add("    game CRC {:08X}, ELF '{}'", crc, std::string_view(reinterpret_cast<const char*>(text), length));
+	}
+	t.Section("VM metadata", s0, d0, "copied");
+
+	// --- cpuRegs block -------------------------------------------------------------------
+	if (!t.Tag("cpuRegs"))
+		return fail("missing cpuRegs tag");
+	{
+		s0 = t.Pos(), d0 = t.OutPos();
+		if (widen)
+		{
+			auto ocpu = std::make_unique<Legacy::cpuRegisters>();
+			auto opsx = std::make_unique<Legacy::psxRegisters>();
+			if (!t.Read(*ocpu) || !t.Read(*opsx))
+				return fail("truncated EE/IOP registers");
+			ctx.ee.Set(ocpu->cycle);
+			ctx.iop.Set(opsx->cycle);
+			ctx.cycles_known = true;
+
+			auto ncpu = std::make_unique<cpuRegisters>();
+			auto npsx = std::make_unique<psxRegisters>();
+			ConvertCpuRegisters(*ocpu, *ncpu, ctx.ee);
+			ConvertPsxRegisters(*opsx, *npsx, ctx.iop);
+			t.Write(*ncpu);
+			t.Write(*npsx);
+			t.Section("EE + IOP registers", s0, d0, "converted (64-bit cycles)");
+			report.Add("    EE cycle {:08X} -> {:016X}, IOP cycle {:08X} -> {:016X}", ctx.ee.now32, ctx.ee.now64,
+				ctx.iop.now32, ctx.iop.now64);
+		}
+		else
+		{
+			if (!t.Copy(sizeof(Legacy::cpuRegisters) + sizeof(Legacy::psxRegisters)))
+				return fail("truncated EE/IOP registers");
+			t.Section("EE + IOP registers", s0, d0, "copied");
+		}
+
+		s0 = t.Pos(), d0 = t.OutPos();
+		if (!pre_9a54)
+		{
+			if (!t.Copy(sizeof(fpuRegs) + sizeof(tlb) + sizeof(cachedTlbs) + sizeof(AllowParams1) + sizeof(AllowParams2)))
+				return fail("truncated FPU/TLB records");
+			t.Section("FPU, TLB, BIOS params", s0, d0, "copied");
+		}
+		else
+		{
+			if (!t.Copy(sizeof(fpuRegs)))
+				return fail("truncated FPU registers");
+			std::array<Legacy::tlbs9A50, std::size(tlb)> old;
+			if (!t.Read(old))
+				return fail("truncated TLB entries");
+			std::array<tlbs, std::size(tlb)> upgraded;
+			cachedTlbs_t cache;
+			int normalized;
+			UpgradeTlb(old.data(), upgraded.data(), cache, &normalized);
+			t.Write(upgraded);
+			t.Write(cache);
+			if (!t.Copy(sizeof(AllowParams1) + sizeof(AllowParams2)))
+				return fail("truncated BIOS parameters");
+			t.Section("FPU, TLB, BIOS params", s0, d0, "TLB rewritten, cached-TLB list rebuilt");
+			report.Add("    {} TLB entries had their cache mode normalized; {} cached mappings listed", normalized, cache.count);
+		}
+	}
+
+	// --- Cycles block --------------------------------------------------------------------
+	if (!t.Tag("Cycles"))
+		return fail("missing Cycles tag");
+	if (!widen)
+	{
+		s0 = t.Pos(), d0 = t.OutPos();
+		if (!t.Copy(6 * sizeof(u32)))
+			return fail("truncated cycle timers");
+		t.Section("cycle timers", s0, d0, "copied");
+	}
+	else
+	{
+		s0 = t.Pos(), d0 = t.OutPos();
+		s32 ee_s, next_delta, psx_next_delta;
+		u32 ee_o, next_start, psx_next_start;
+		if (!t.Read(ee_s) || !t.Read(ee_o) || !t.Read(next_delta) || !t.Read(next_start) || !t.Read(psx_next_start) ||
+			!t.Read(psx_next_delta))
+		{
+			return fail("truncated cycle timers");
+		}
+		t.Write(ee_s);
+		t.Write(ctx.ee.Past(ee_o));
+		t.Write(next_delta);
+		t.Write(ctx.ee.Past(next_start));
+		t.Write(ctx.iop.Past(psx_next_start));
+		t.Write(psx_next_delta);
+		t.Section("cycle timers", s0, d0, "converted");
+	}
+
+	// --- EE subsystems -------------------------------------------------------------------
+	if (!t.Tag("EE-Subsystems"))
+		return fail("missing EE-Subsystems tag");
+
+	// rcntFreeze (Counters.cpp)
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!widen)
+	{
+		if (!t.Copy(std::size(counters) * sizeof(Legacy::Counter) + 2 * sizeof(Legacy::SyncCounter) + sizeof(s32) + sizeof(u32)))
+			return fail("truncated EE counters");
+	}
+	else
+	{
+	for (size_t i = 0; i < std::size(counters); i++)
+	{
+		Legacy::Counter o;
+		if (!t.Read(o))
+			return fail("truncated EE counter");
+		Counter n;
+		std::memset(&n, 0, sizeof(n));
+		n.count = o.count;
+		n.modeval = o.modeval;
+		n.target = o.target;
+		n.hold = o.hold;
+		n.rate = o.rate;
+		n.interrupt = o.interrupt;
+		n.startCycle = ctx.ee.Past(o.startCycle);
+		t.Write(n);
+	}
+	for (int i = 0; i < 2; i++)
+	{
+		Legacy::SyncCounter o;
+		if (!t.Read(o))
+			return fail("truncated EE sync counter");
+		SyncCounter n;
+		std::memset(&n, 0, sizeof(n));
+		n.Mode = o.Mode;
+		n.startCycle = ctx.ee.Past(o.startCycle);
+		n.deltaCycles = o.deltaCycles;
+		t.Write(n);
+	}
+	{
+		s32 delta;
+		u32 start;
+		if (!t.Read(delta) || !t.Read(start))
+			return fail("truncated EE counter schedule");
+		t.Write(delta);
+		t.Write(ctx.ee.Past(start));
+	}
+	} // widen
+	if (!t.Copy(VSYNC_TIMING_INFO_SIZE + sizeof(gsVideoMode) + sizeof(gsIsInterlaced)))
+		return fail("truncated video timing record");
+	t.Section("EE counters", s0, d0, widen ? "converted" : "copied");
+
+	// memFreeze (Memory.cpp) and gsFreeze (GS.cpp)
+	s0 = t.Pos(), d0 = t.OutPos();
+	{
+		const u8* mem = t.Peek(MEMORY_FREEZE_SIZE);
+		if (!mem)
+			return fail("truncated memory controller record");
+		if (mem[MEMORY_FREEZE_SIZE - 1] > 1)
+			return fail("invalid extra-memory flag");
+		if (mem[MEMORY_FREEZE_SIZE - 1])
+			report.Add("    state requires 128MB extra memory to be enabled in the target VM");
+		t.Copy(MEMORY_FREEZE_SIZE);
+	}
+	t.Section("memory controller", s0, d0, "copied");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(Ps2MemSize::GSregs + sizeof(gsVideoMode)))
+		return fail("truncated GS register image");
+	t.Section("GS registers", s0, d0, "copied");
+
+	// vuMicroFreeze (VUmicroMem.cpp)
+	if (!t.Tag("vuMicroRegs"))
+		return fail("missing vuMicroRegs tag (EE counter/memory layout mismatch)");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!widen)
+	{
+		if (!t.Copy(Legacy::VU_MICRO_SIZE))
+			return fail("truncated VU registers");
+		t.Section("VU0 + VU1 registers", s0, d0, "copied");
+	}
+	else
+	{
+		if (!ConvertVuMicro(t, false, ctx.ee) || !ConvertVuMicro(t, true, ctx.ee))
+			return fail("truncated VU registers");
+		t.Section("VU0 + VU1 registers", s0, d0, "converted (64-bit cycles)");
+	}
+
+	// vuJITFreeze (x86/microVU.cpp)
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(2 * MICRO_REG_INFO_SIZE))
+		return fail("truncated microVU state");
+	t.Section("microVU block state", s0, d0, "copied");
+
+	// vif0Freeze / vif1Freeze (Vif.cpp)
+	for (int i = 0; i < 2; i++)
+	{
+		if (!t.Tag(i == 0 ? "VIF0dma" : "VIF1dma"))
+			return fail(i == 0 ? "missing VIF0dma tag (VU layout mismatch)" : "missing VIF1dma tag");
+		s0 = t.Pos(), d0 = t.OutPos();
+		if (!t.Copy(sizeof(g_vif0Cycles) + sizeof(vifStruct)))
+			return fail("truncated VIF registers");
+		u32 buffered;
+		if (!t.Read(buffered))
+			return fail("truncated VIF buffer length");
+		if (buffered > sizeof(nVif[0].buffer))
+			return fail(fmt::format("VIF buffer length {} exceeds {}", buffered, sizeof(nVif[0].buffer)));
+		t.Write(buffered);
+		if (!t.Copy(buffered))
+			return fail("truncated VIF buffer");
+		t.Section(i == 0 ? "VIF0" : "VIF1", s0, d0, "copied");
+	}
+
+	// sifFreeze (Sif.cpp)
+	if (!t.Tag("SIFdma"))
+		return fail("missing SIFdma tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(sizeof(sif0) + sizeof(sif1)))
+		return fail("truncated SIF channels");
+	t.Section("SIF", s0, d0, "copied");
+
+	// ipuFreeze (IPU/IPU.cpp)
+	if (!t.Tag("IPU"))
+		return fail("missing IPU tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(sizeof(ipu_fifo) + sizeof(g_BP) + sizeof(g_ipu_vqclut) + sizeof(g_ipu_thresh) +
+				sizeof(coded_block_pattern) + sizeof(decoder) + sizeof(ipu_cmd) + sizeof(IPUCoreStatus)))
+	{
+		return fail("truncated IPU state");
+	}
+	t.Section("IPU", s0, d0, "copied");
+
+	// ipuDmaFreeze (IPU/IPUdma.cpp)
+	if (!t.Tag("IPUdma"))
+		return fail("missing IPUdma tag (IPU layout mismatch)");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(sizeof(IPU1Status)))
+		return fail("truncated IPU DMA state");
+	t.Section("IPU DMA", s0, d0, "copied");
+
+	// gifFreeze / gifPathFreeze (Gif_Unit.cpp)
+	if (!t.Tag("Gif Unit"))
+		return fail("missing Gif Unit tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(sizeof(bool) + sizeof(gifUnit.stat) + sizeof(gifUnit.gsSIGNAL) + sizeof(gifUnit.gsFINISH) +
+				sizeof(gifUnit.lastTranType)))
+	{
+		return fail("truncated GIF unit");
+	}
+	for (int path = 0; path < 3; path++)
+	{
+		constexpr size_t path_size = sizeof(Gif_Path) - sizeof(Gif_Path_MTVU);
+		if (!t.Copy(sizeof(Gif_Path_MTVU::fakePackets)))
+			return fail("truncated GIF path");
+		const u8* raw = t.Peek(path_size);
+		if (!raw)
+			return fail("truncated GIF path");
+		u32 buff_size, cur_size;
+		std::memcpy(&buff_size, raw + offsetof(Gif_Path, buffSize), sizeof(buff_size));
+		std::memcpy(&cur_size, raw + offsetof(Gif_Path, curSize), sizeof(cur_size));
+		if (cur_size > buff_size)
+			return fail(fmt::format("GIF path {} buffer use {} exceeds capacity {}", path + 1, cur_size, buff_size));
+		t.Copy(path_size);
+		if (!t.Copy(cur_size))
+			return fail("truncated GIF path buffer");
+	}
+	t.Section("GIF unit + paths", s0, d0, "copied");
+
+	// gifDmaFreeze (Gif.cpp)
+	if (!t.Tag("GIFdma"))
+		return fail("missing GIFdma tag (GIF path layout mismatch)");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(sizeof(gif) + sizeof(gif_fifo)))
+		return fail("truncated GIF DMA state");
+	t.Section("GIF DMA", s0, d0, "copied");
+
+	// sprFreeze (SPR.cpp)
+	if (!t.Tag("SPRdma"))
+		return fail("missing SPRdma tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(SPR_FREEZE_SIZE))
+		return fail("truncated SPR DMA state");
+	t.Section("SPR DMA", s0, d0, "copied");
+
+	// mtvuFreeze (MTVU.cpp)
+	if (!t.Tag("MTVU"))
+		return fail("missing MTVU tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(4 * sizeof(unsigned int) + sizeof(u32) + sizeof(u64) + sizeof(u64) + sizeof(vu1Thread.vuCycleIdx)))
+		return fail("truncated MTVU state");
+	t.Section("MTVU", s0, d0, "copied");
+
+	// --- IOP subsystems ------------------------------------------------------------------
+	if (!t.Tag("IOP-Subsystems"))
+		return fail("missing IOP-Subsystems tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!t.Copy(sizeof(iopMem->Sif)))
+		return fail("truncated IOP SIF registers");
+	t.Section("IOP SIF registers", s0, d0, "copied");
+
+	// psxRcntFreeze (IopCounters.cpp)
+	if (!t.Tag("iopCounters"))
+		return fail("missing iopCounters tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	if (!widen)
+	{
+		if (!t.Copy(std::size(psxCounters) * sizeof(Legacy::psxCounter) + sizeof(s32) + sizeof(u32) + 2 * sizeof(bool)))
+			return fail("truncated IOP counters");
+		t.Section("IOP counters", s0, d0, "copied");
+	}
+	else
+	{
+	for (size_t i = 0; i < std::size(psxCounters); i++)
+	{
+		Legacy::psxCounter o;
+		if (!t.Read(o))
+			return fail("truncated IOP counter");
+		psxCounter n;
+		std::memset(&n, 0, sizeof(n));
+		n.count = o.count;
+		n.target = o.target;
+		n.rate = o.rate;
+		n.interrupt = o.interrupt;
+		n.startCycle = ctx.iop.Past(o.startCycle);
+		n.deltaCycles = o.deltaCycles;
+		n.mode = o.mode;
+		n.currentIrqMode = o.currentIrqMode;
+		t.Write(n);
+	}
+	{
+		s32 delta;
+		u32 start;
+		if (!t.Read(delta) || !t.Read(start))
+			return fail("truncated IOP counter schedule");
+		t.Write(delta);
+		t.Write(ctx.iop.Past(start));
+		if (!t.Copy(2 * sizeof(bool))) // hBlanking, vBlanking
+			return fail("truncated IOP blanking flags");
+	}
+	t.Section("IOP counters", s0, d0, "converted");
+	} // widen
+
+	// Sio0/Sio2/Multitap StateWrapper block (SaveState.cpp, SIO/*.cpp). Same encoding from
+	// 0x9A4F to this build (fields renamed only), except that 0x9A54 appended
+	// sioLastFrameMcdBusy to Sio2. Walked to find its length, then copied verbatim.
+	s0 = t.Pos(), d0 = t.OutPos();
+	{
+		WrapperWalker w(t.Peek(0), t.Remaining());
+		const bool sio0 = w.Marker("Sio0") &&
+						  w.Skip(sizeof(u32) * 3 + sizeof(u16) * 3) && // txData, rxData, stat, mode, ctrl, baud (private)
+						  w.Skip(SizeOf<decltype(Sio0::flag)>() + SizeOf<decltype(Sio0::sioStage)>() +
+								 SizeOf<decltype(Sio0::sioMode)>() + SizeOf<decltype(Sio0::sioCommand)>() +
+								 SizeOf<decltype(Sio0::padStarted)>() + SizeOf<decltype(Sio0::rxDataSet)>() +
+								 SizeOf<decltype(Sio0::port)>() + SizeOf<decltype(Sio0::slot)>());
+		const bool sio2 = sio0 && w.Marker("Sio2") &&
+						  w.Skip(SizeOf<decltype(Sio2::CmdQueue)>() + SizeOf<decltype(Sio2::PortCtrl0)>() +
+								 SizeOf<decltype(Sio2::PortCtrl1)>() + SizeOf<decltype(Sio2::dataIn)>() +
+								 SizeOf<decltype(Sio2::dataOut)>() + SizeOf<decltype(Sio2::ctrl)>() +
+								 SizeOf<decltype(Sio2::CmdStat)>() + SizeOf<decltype(Sio2::PortStat)>() +
+								 SizeOf<decltype(Sio2::FifoStat)>() + SizeOf<decltype(Sio2::FifoTxPos)>() +
+								 SizeOf<decltype(Sio2::FifoRxPos)>() + SizeOf<decltype(Sio2::iStat)>() +
+								 SizeOf<decltype(Sio2::port)>() + SizeOf<decltype(Sio2::queueRead)>() +
+								 SizeOf<decltype(Sio2::queuePosition)>() + SizeOf<decltype(Sio2::commandLength)>() +
+								 SizeOf<decltype(Sio2::processedLength)>() + SizeOf<decltype(Sio2::dmaBlockSize)>() +
+								 SizeOf<decltype(Sio2::queueComplete)>()) &&
+						  w.ByteDeque(64 * 1024) && w.ByteDeque(64 * 1024) &&
+						  w.Skip(sizeof(u64) * SIO::PORTS * SIO::SLOTS) && // memory card CRCs
+						  (pre_9a54 || w.Skip(sizeof(sioLastFrameMcdBusy)));
+		const size_t sio2_end = w.Pos();
+		const bool taps = sio2 && w.Marker("Multitap") && w.Skip(2) && w.Marker("Multitap") && w.Skip(2);
+		if (!taps)
+			return fail(sio0 ? (sio2 ? "invalid Multitap state" : "invalid Sio2 state") : "invalid Sio0 state");
+		if (!pre_9a54)
+		{
+			t.Copy(w.Pos());
+		}
+		else
+		{
+			// SIO.cpp: the frame of the last memory card access, used only for the "no memory card
+			// save in a long time" notice. The older formats do not record it; 0 is the value a
+			// freshly booted VM has.
+			t.Copy(sio2_end);
+			t.Write(static_cast<decltype(sioLastFrameMcdBusy)>(0));
+			t.Copy(w.Pos() - sio2_end);
+		}
+	}
+	t.Section("SIO0/SIO2/Multitap", s0, d0, pre_9a54 ? "copied (walked), field added" : "copied (walked)");
+	if (pre_9a54)
+		report.Add("    sioLastFrameMcdBusy (introduced in 0x9A54) set to 0");
+
+	// cdrFreeze, cdvdFreeze, deci2Freeze, InputRecordingFreeze
+	struct Record
+	{
+		const char* tag;
+		size_t size;
+	};
+	for (const Record& record : {Record{"cdrom", sizeof(cdr)}, Record{"cdvd", sizeof(cdvd)},
+			 Record{"deci2", DECI2_FREEZE_SIZE}, Record{"InputRecording", sizeof(g_FrameCount)}})
+	{
+		if (!t.Tag(record.tag))
+			return fail(fmt::format("missing {} tag", record.tag));
+		s0 = t.Pos(), d0 = t.OutPos();
+		if (!t.Copy(record.size))
+			return fail(fmt::format("truncated {} record", record.tag));
+		t.Section(record.tag, s0, d0, "copied");
+	}
+
+	// handleFreeze (IopBios.cpp). Absent in 0x9A4F; in 0x9A50 written only when the saving VM
+	// had HostFs enabled. From 0x9A54 the tag and a count are always present.
+	if (format == 0x9A4F || (format == 0x9A50 && t.Remaining() == 0))
+	{
+		d0 = t.OutPos();
+		char tag[32] = {};
+		StringUtil::Strlcpy(tag, "hostHandles", sizeof(tag));
+		t.Put(tag, sizeof(tag));
+		t.Write(static_cast<size_t>(0));
+		t.Section("host file handles", t.Pos(), d0, "added (none in source)");
+	}
+	else
+	{
+	if (!t.Tag("hostHandles"))
+		return fail("missing hostHandles tag");
+	s0 = t.Pos(), d0 = t.OutPos();
+	{
+		size_t count;
+		if (!t.Read(count) || count > 1024)
+			return fail("invalid host file handle count");
+		t.Write(count);
+		for (size_t i = 0; i < count; i++)
+		{
+			s32 pos, flags;
+			u32 length;
+			if (!t.Read(pos) || !t.Read(flags) || !t.Read(length) || length > 4096)
+				return fail("invalid host file handle");
+			t.Write(pos);
+			t.Write(flags);
+			t.Write(length);
+			if (!t.Copy(length) || !t.Copy(sizeof(u16)))
+				return fail("truncated host file handle");
+		}
+		if (count > 0)
+			report.Add("    {} host filesystem handle(s); restored only when HostFs is enabled", count);
+	}
+	t.Section("host file handles", s0, d0, "copied");
+	} // hostHandles present
+
+	if (t.Remaining() != 0)
+		return fail(fmt::format("{} unconsumed trailing bytes", t.Remaining()));
+
+	if (widen)
+		report.Add("  live timestamps predating a 32-bit counter wrap: EE {}, IOP {}", ctx.ee.wrapped, ctx.iop.wrapped);
+	report.Add("  complete: consumed {} of {} source bytes, produced {} target bytes", t.Pos(), src.size(), dst.size());
+	return true;
+}
+
+bool SaveStateLegacy::ConvertInternalStructures(std::span<const u8> src, std::vector<u8>& dst, Context& ctx, Report& report, Error* error)
+{
+	return TranslateInternals(src, dst, ctx, report, error, 0x9A54, true);
+}
+
+bool SaveStateLegacy::UpgradeInternalsTo9A54(std::span<const u8> src, std::vector<u8>& dst, u16 source_format, Report& report, Error* error)
+{
+	if (source_format != 0x9A4F && source_format != 0x9A50)
+	{
+		Error::SetStringFmt(error, "No 0x9A54 upgrade for format 0x{:04X}.", source_format);
+		return false;
+	}
+	Context unused;
+	return TranslateInternals(src, dst, unused, report, error, source_format, false);
+}
+
+// --------------------------------------------------------------------------------------
+//  SPU2
+// --------------------------------------------------------------------------------------
+namespace
+{
+	// pcsx2/SPU2/Mixer.cpp (identical in both formats)
+	static constexpr s32 s_xa_factor[16][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+
+	// Decodes samples [first, 27] of the ADPCM block at word address `block`, continuing the
+	// predictor from the two preceding samples. Same arithmetic as XA_decode_block().
+	static void DecodeBlockTail(const s16* mem, u32 block, int first, s32 prev1, s32 prev2, s16 out[28])
+	{
+		const s32 header = mem[block];
+		const s32 shift = (header & 0xF) + 16;
+		const int id = (header >> 4) & 0xF;
+		const s32 pred1 = s_xa_factor[id][0];
+		const s32 pred2 = s_xa_factor[id][1];
+		for (int i = first; i < 28; i++)
+		{
+			const u16 word = static_cast<u16>(mem[block + 1 + i / 4]);
+			const s32 data = static_cast<s32>(static_cast<u32>((word >> ((i & 3) * 4)) & 0xF) << 28);
+			const s32 pcm = std::clamp<s32>((data >> shift) + (((pred1 * prev1) + (pred2 * prev2) + 32) >> 6), -0x8000, 0x7fff);
+			out[i] = static_cast<s16>(pcm);
+			prev2 = prev1;
+			prev1 = pcm;
+		}
+	}
+
+	struct SpuStats
+	{
+		int active = 0;
+		int exact = 0;
+		int unverified = 0;
+		int pending_loop_applied = 0;
+		int pending_loop_dropped = 0;
+	};
+
+	// The sample block held in the legacy voice's decode cache (SBuffer), if it can be
+	// determined without ambiguity. In the legacy mixer NextA is the next word to fetch and
+	// the block boundary is crossed when the first sample of the block's last word is fetched.
+	template <typename Voice>
+	static std::optional<u32> LegacyCurrentBlock(const Voice& v, std::optional<uptr> cache_base)
+	{
+		const int k = v.SCurrent - 1;
+		if (k < 24)
+		{
+			if ((v.NextA & 7) != static_cast<u32>(2 + k / 4))
+				return std::nullopt;
+			return v.NextA & 0xFFFF8;
+		}
+		if ((v.NextA & 7) != 1)
+			return std::nullopt;
+		if (!(v.LoopFlags & XAFLAG_LOOP_END))
+			return ((v.NextA & 0xFFFF8) - 8) & 0xFFFFF;
+		// Looped: the block address is no longer derivable from NextA. Recover it from the saved
+		// cache pointer, using the cache base established by the unambiguous voices.
+		if (!cache_base.has_value())
+			return std::nullopt;
+		const uptr ptr = reinterpret_cast<uptr>(v.SBuffer) - offsetof(PcmCacheEntry, Sampledata);
+		if (ptr < *cache_base || (ptr - *cache_base) % sizeof(PcmCacheEntry) != 0)
+			return std::nullopt;
+		const uptr index = (ptr - *cache_base) / sizeof(PcmCacheEntry);
+		if (index >= static_cast<uptr>(pcm_BlockCount))
+			return std::nullopt;
+		return static_cast<u32>(index * pcm_WordsPerBlock);
+	}
+
+	template <typename Voice>
+	static bool IsDecodingVoice(const Voice& v)
+	{
+		return v.ADSR.Phase > V_ADSR::PHASE_STOPPED && !v.Noise;
+	}
+
+	// Translates the legacy interpolation state (SCurrent, PV1..PV4, SP < 0) into the decode
+	// FIFO model (DecodeFifo, DecPosRead/DecPosWrite, SP >= 0) introduced at 10fc9a79.
+	//
+	// Legacy: the four most recently fetched samples PV4..PV1 are interpolated at
+	// (SP + 0x1000); NextA is the next ADPCM word to fetch; the current word has
+	// 3 - ((SCurrent - 1) & 3) samples not yet fetched.
+	// Target: interpolation reads DecodeFifo[DecPosRead + 0..3] at SP; decoding appends whole
+	// words at DecPosWrite and NextA is the next word to decode.
+	//
+	// The FIFO therefore holds PV4..PV1 followed by the unfetched remainder of the current
+	// word, and NextA carries over unchanged. Both mixers perform the IRQ-address check and
+	// the block-end/loop handling when a word is first read, so no reads are skipped or
+	// repeated. The remainder samples are decoded from the saved SPU2 RAM using PV1/PV2 as
+	// predictor history; the decode must reproduce the saved block-end history (Prev1/Prev2),
+	// otherwise those samples are left at zero (what a native load of the cache would give).
+	template <typename Voice>
+	static void ConvertVoice(const Voice& o, V_Voice& n, const s16* mem, std::optional<uptr> cache_base,
+		int core, int index, SpuStats& stats, Report& report)
+	{
+		std::memset(&n, 0, sizeof(n));
+		n.Volume = o.Volume;
+		n.ADSR = o.ADSR;
+		n.Pitch = o.Pitch;
+		n.LoopStartA = o.LoopStartA;
+		n.StartA = o.StartA;
+		n.NextA = o.NextA;
+		n.Prev1 = o.Prev1;
+		n.Prev2 = o.Prev2;
+		n.Modulated = o.Modulated;
+		n.Noise = o.Noise;
+		n.LoopMode = o.LoopMode;
+		n.LoopFlags = o.LoopFlags;
+		n.OutX = o.OutX;
+		n.SBuffer = nullptr; // recomputed by SPU2Savestate::ThawIt()
+
+		// 0x9A54 only: deferred LSA write (written within 4T of key-on). The legacy mixer applies
+		// it at its next fetch unless the waveform has set the loop point since key-on; later
+		// mixers apply LSA writes immediately. Resolve it with the legacy rule.
+		if constexpr (requires { o.PendingLoopStart; })
+		{
+			if (o.PendingLoopStart)
+			{
+				if (static_cast<s32>(o.LoopCycle - o.PlayCycle) < 0)
+				{
+					n.LoopStartA = o.PendingLoopStartA;
+					n.LoopMode = 1;
+					stats.pending_loop_applied++;
+				}
+				else
+				{
+					stats.pending_loop_dropped++;
+				}
+			}
+		}
+
+		const int k = o.SCurrent - 1;
+		const int remainder = 3 - (k & 3);
+		s32 fifo[32] = {};
+		fifo[0] = o.PV4;
+		fifo[1] = o.PV3;
+		fifo[2] = o.PV2;
+		fifo[3] = o.PV1;
+
+		if (IsDecodingVoice(o))
+		{
+			stats.active++;
+			// With the current word fully fetched there is nothing to reconstruct.
+			bool exact = (remainder == 0);
+			if (!exact)
+			{
+				if (const std::optional<u32> block = LegacyCurrentBlock(o, cache_base); block.has_value())
+				{
+					// k <= 26 here. Reproduce the rest of the block and require the saved
+					// block-end predictor history (s26, s27) to match.
+					s16 decoded[28] = {};
+					DecodeBlockTail(mem, *block, k + 1, o.PV1, o.PV2, decoded);
+					const s32 s26 = (k <= 25) ? decoded[26] : o.PV1;
+					exact = (decoded[27] == o.Prev1 && s26 == o.Prev2);
+					if (exact)
+					{
+						for (int i = 0; i < remainder; i++)
+							fifo[4 + i] = decoded[k + 1 + i];
+					}
+				}
+			}
+			if (exact)
+				stats.exact++;
+			else
+			{
+				stats.unverified++;
+				report.Add("    core {} voice {:2}: current ADPCM block not reproducible from SPU2 RAM; "
+						   "{} unfetched sample(s) of the current word left silent",
+					core, index, remainder);
+			}
+		}
+
+		std::memcpy(n.DecodeFifo, fifo, sizeof(fifo));
+		n.DecPosRead = 0;
+		n.DecPosWrite = 4 + remainder;
+		n.SP = (o.SP + 0x1000) & 0xFFF;
+	}
+} // namespace
+
+namespace
+{
+template <typename Block>
+static bool ConvertSPU2Block(std::span<const u8> src, std::vector<u8>& dst, const Context& ctx, u16 format, Report& report, Error* error)
+{
+	auto fail = [&](std::string_view what) {
+		const std::string message = fmt::format("Legacy 0x{:04X} SPU2: {}.", format, what);
+		report.Add(message);
+		Error::SetString(error, message);
+		return false;
+	};
+
+	report.Add("SPU2 ({} bytes, 0x{:04X} layout):", src.size(), format);
+	if (src.size() != sizeof(Block))
+		return fail(fmt::format("size {} does not match the 0x{:04X} layout ({})", src.size(), format, sizeof(Block)));
+	if (!ctx.cycles_known)
+		return fail("IOP clock reference unavailable");
+
+	auto o = std::make_unique<Block>();
+	std::memcpy(static_cast<void*>(o.get()), src.data(), sizeof(Block));
+	if (o->spu2id != SPU2_SAVE_ID || o->version != SPU2_SAVE_VERSION)
+		return fail(fmt::format("unexpected identifier {:08X}/version {:04X}", o->spu2id, o->version));
+
+	auto n = std::make_unique<Target::DataBlock>();
+	std::memset(static_cast<void*>(n.get()), 0, sizeof(Target::DataBlock));
+	n->spu2id = o->spu2id;
+	std::memcpy(n->unkregs, o->unkregs, sizeof(n->unkregs));
+	std::memcpy(n->mem, o->mem, sizeof(n->mem));
+	n->version = o->version;
+
+	const s16* mem = reinterpret_cast<const s16*>(o->mem);
+
+	// Establish the base address of the legacy process's pcm_cache_data from voices whose
+	// cached block is unambiguous; needed only for voices that looped inside their last word.
+	std::optional<uptr> cache_base;
+	bool base_conflict = false;
+	for (const auto& core : o->Cores)
+	{
+		for (const auto& v : core.Voices)
+		{
+			if (v.SCurrent < 1 || v.SCurrent > 28)
+				return fail(fmt::format("voice sample position {} outside 1..28", v.SCurrent));
+			// Freshly keyed-on voices (SCurrent == 28) still hold the previous sound's cache pointer.
+			if (!IsDecodingVoice(v) || !v.SBuffer || v.SCurrent == 28)
+				continue;
+			const std::optional<u32> block = LegacyCurrentBlock(v, std::nullopt);
+			if (!block.has_value())
+				continue;
+			const uptr base = reinterpret_cast<uptr>(v.SBuffer) - offsetof(PcmCacheEntry, Sampledata) -
+							  static_cast<uptr>(*block / pcm_WordsPerBlock) * sizeof(PcmCacheEntry);
+			if (cache_base.has_value() && *cache_base != base)
+				base_conflict = true;
+			cache_base = base;
+		}
+	}
+	if (base_conflict)
+		cache_base.reset();
+
+	SpuStats stats;
+	for (int c = 0; c < 2; c++)
+	{
+		const auto& oc = o->Cores[c];
+		V_Core& nc = n->Cores[c];
+
+		// Index .. FxVol: identical layout (static_assert above).
+		std::memcpy(static_cast<void*>(&nc), &oc, offsetof(V_Core, Voices));
+
+		for (int v = 0; v < V_Core::NumVoices; v++)
+		{
+			const auto& ov = oc.Voices[v];
+			if (ov.ADSR.Phase != V_ADSR::PHASE_STOPPED || ov.ADSR.Value != 0)
+			{
+				report.Add("    core {} voice {:2}: phase {} env {:5} pitch {:04X} noise {} SSA {:05X} NAX {:05X} LSA {:05X} "
+						   "flags {:X} SCurrent {:2} SP {:6} PV {:6} {:6} {:6} {:6} prev {:6} {:6}",
+					c, v, ov.ADSR.Phase, ov.ADSR.Value, ov.Pitch, ov.Noise ? 1 : 0, ov.StartA, ov.NextA, ov.LoopStartA,
+					static_cast<u8>(ov.LoopFlags), ov.SCurrent, ov.SP, ov.PV4, ov.PV3, ov.PV2, ov.PV1, ov.Prev2, ov.Prev1);
+			}
+			ConvertVoice(ov, nc.Voices[v], mem, cache_base, c, v, stats, report);
+		}
+
+		nc.IRQA = oc.IRQA;
+		nc.TSA = oc.TSA;
+		nc.ActiveTSA = oc.ActiveTSA;
+		nc.IRQEnable = oc.IRQEnable;
+		nc.FxEnable = oc.FxEnable;
+		nc.Mute = oc.Mute;
+		nc.AdmaInProgress = oc.AdmaInProgress;
+		nc.DMABits = oc.DMABits;
+		nc.NoiseClk = oc.NoiseClk;
+		nc.NoiseCnt = oc.NoiseCnt;
+		nc.NoiseOut = oc.NoiseOut;
+		nc.AutoDMACtrl = oc.AutoDMACtrl;
+		nc.DMAICounter = oc.DMAICounter;
+		nc.LastClock = ctx.iop.Near(oc.LastClock); // IOP clock (psxRegs.cycle) timestamp
+		nc.InputDataLeft = oc.InputDataLeft;
+		nc.InputDataTransferred = oc.InputDataTransferred;
+		nc.InputPosWrite = oc.InputPosWrite;
+		nc.InputDataProgress = oc.InputDataProgress;
+		nc.Revb = oc.Revb;
+		std::memcpy(nc.RevbDownBuf, oc.RevbDownBuf, sizeof(nc.RevbDownBuf));
+		std::memcpy(nc.RevbUpBuf, oc.RevbUpBuf, sizeof(nc.RevbUpBuf));
+		nc.RevbSampleBufPos = oc.RevbSampleBufPos;
+		nc.EffectsStartA = oc.EffectsStartA;
+		nc.EffectsEndA = oc.EffectsEndA;
+		nc.Regs = oc.Regs;
+		nc.LastEffect = oc.LastEffect;
+		nc.CoreEnabled = oc.CoreEnabled;
+		nc.AttrBit0 = oc.AttrBit0;
+		nc.DmaMode = oc.DmaMode;
+		nc.DmaStarted = oc.DmaStarted;
+		nc.AutoDmaFree = oc.AutoDmaFree;
+		nc.DMAPtr = oc.DMAPtr; // saved as offsets from IOP RAM (FIX_POINTER), unchanged encoding
+		nc.DMARPtr = oc.DMARPtr;
+		nc.ReadSize = oc.ReadSize;
+		nc.IsDMARead = oc.IsDMARead;
+		// KeyOn holds voices whose key-on is pending: in 0x9A54 those queued by a KON write
+		// (started after a 2T delay), from 0x9A55 the raw mask applied on the next tick, as in
+		// the target. 0x9A54 applies KOFF writes immediately, so nothing can be pending there.
+		nc.KeyOn = oc.KeyOn;
+		if constexpr (requires { oc.KeyOff; })
+			nc.KeyOff = oc.KeyOff;
+		else
+			nc.KeyOff = 0;
+		nc.psxSoundDataTransferControl = oc.psxSoundDataTransferControl;
+		nc.psxSPUSTAT = oc.psxSPUSTAT;
+
+		if (oc.KeyOn)
+			report.Add("    core {}: pending key-on mask {:06X} carried over", c, oc.KeyOn);
+	}
+
+	std::memcpy(static_cast<void*>(&n->Spdif), &o->Spdif, sizeof(V_SPDIF));
+	n->OutPos = o->OutPos;
+	n->InputPos = o->InputPos;
+	n->Cycles = o->Cycles;
+	n->lClocks = ctx.iop.Near(o->lClocks);
+	n->PlayMode = o->PlayMode;
+
+	report.Add("  voices: {} decoding, {} with exact decode continuation, {} with silent remainder",
+		stats.active, stats.exact, stats.unverified);
+	if (stats.pending_loop_applied || stats.pending_loop_dropped)
+		report.Add("  deferred loop-start writes: {} applied, {} superseded by waveform loop flags",
+			stats.pending_loop_applied, stats.pending_loop_dropped);
+	report.Add("  ADPCM cache base {}", cache_base.has_value() ? "recovered" : "not needed or unavailable");
+	report.Add("  complete: {} -> {} bytes", src.size(), sizeof(Target::DataBlock));
+
+	const u8* bytes = reinterpret_cast<const u8*>(n.get());
+	dst.assign(bytes, bytes + sizeof(Target::DataBlock));
+	return true;
+}
