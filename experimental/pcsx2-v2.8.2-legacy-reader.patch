+// Experimental: legacy 0x9A4F/0x9A50/0x9A54/0x9A55 states are translated in memory (SaveStateLegacy.cpp) into
+// a complete native archive before PreLoadPrep(), so a state that cannot be fully translated
+// never touches the VM. The native load path below is then used unchanged.
+static bool ReadStateVersion(zip_t* zf, u32* version)
+{
+	auto zff = zip_fopen_managed(zf, EntryFilename_StateVersion, 0);
+	return zff && zip_fread(zff.get(), version, sizeof(*version)) == static_cast<zip_int64_t>(sizeof(*version));
+}
+
+// The translation module mirrors the private SPU2Savestate::DataBlock; refuse to use it if this
+// build's SPU2 block differs.
+static bool CheckLegacyTranslationLayout(Error* error)
+{
+	if (SaveStateLegacy::TargetSPU2Size() == static_cast<size_t>(SPU2Savestate::SizeIt()))
+		return true;
+	Error::SetStringFmt(error, "Legacy translation SPU2 layout ({} bytes) does not match this build ({} bytes).",
+		SaveStateLegacy::TargetSPU2Size(), SPU2Savestate::SizeIt());
+	return false;
+}
+
+bool SaveState_ConvertLegacy(const std::string& filename, const std::string& output, std::vector<std::string>* report, Error* error)
+{
+	if (!CheckLegacyTranslationLayout(error))
+		return false;
+
+	zip_error_t ze = {};
+	auto zf = zip_open_managed(filename.c_str(), ZIP_RDONLY, &ze);
+	if (!zf)
+	{
+		Error::SetStringFmt(error, "Failed to open '{}': {}", filename, zip_error_strerror(&ze));
+		return false;
+	}
+
+	SaveStateLegacy::ConvertedState state;
+	const bool converted = SaveStateLegacy::ConvertArchive(zf.get(), &state, error);
+	if (report)
+		*report = state.report.lines;
+	if (!converted)
+		return false;
+
+	if (!output.empty() && !SaveStateLegacy::WriteArchive(state, output.c_str(), error))
+		return false;
+
+	// Re-read the produced archive through the native entry validation as a consistency check.
+	auto native = SaveStateLegacy::OpenAsNativeArchive(state, error);
+	return static_cast<bool>(native);
+}
