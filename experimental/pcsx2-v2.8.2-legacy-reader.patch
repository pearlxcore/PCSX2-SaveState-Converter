diff --git a/pcsx2-stateconvert/main.cpp b/pcsx2-stateconvert/main.cpp
new file mode 100644
index 000000000..47e4558c7
--- /dev/null
+++ b/pcsx2-stateconvert/main.cpp
@@ -0,0 +1,206 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+// pcsx2-stateconvert: standalone translator for legacy PCSX2 save states.
+// Compiled from the same translation module (pcsx2/SaveStateLegacy.cpp) that the experimental
+// emulator loader uses, so standalone conversion and in-emulator loading cannot diverge.
+//
+//   pcsx2-stateconvert [--json] inspect <state.p2s> [--target 9A50|9A54|9A55|9A59]
+//   pcsx2-stateconvert [--json] convert <legacy.p2s> <output.p2s> [--target 9A50|9A54|9A55|9A59]
+//   pcsx2-stateconvert [--json] formats
+//
+// Sources: 0x9A4F (2.0.x), 0x9A50 (2.2.0), 0x9A54 (2.4.0), 0x9A55 (2.6.x). The default target is
+// this build's format (0x9A59, PCSX2 2.8.2); older targets are reachable only from older sources
+// (see `formats`).
+//
+// Exit codes: 0 success, 1 not convertible or invalid input, 2 usage, 3 output could not be written.
+
+#include "SaveState.h"
+#include "SaveStateLegacy.h"
+
+#include "common/Error.h"
+#include "common/StringUtil.h"
+#include "common/ZipHelpers.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace
+{
+	std::string JsonEscape(std::string_view text)
+	{
+		std::string out;
+		out.reserve(text.size() + 2);
+		for (const char ch : text)
+		{
+			switch (ch)
+			{
+				case '"': out += "\\\""; break;
+				case '\\': out += "\\\\"; break;
+				case '\n': out += "\\n"; break;
+				case '\r': out += "\\r"; break;
+				case '\t': out += "\\t"; break;
+				default:
+					if (static_cast<unsigned char>(ch) < 0x20)
+						out += fmt::format("\\u{:04x}", static_cast<unsigned>(ch));
+					else
+						out += ch;
+					break;
+			}
+		}
+		return out;
+	}
+
+	struct Result
+	{
+		bool ok = false;
+		int exit_code = 1;
+		std::string error;
+		std::string output;
+		const SaveStateLegacy::ConvertedState* state = nullptr;
+	};
+
+	void Print(const Result& result, bool json)
+	{
+		const SaveStateLegacy::ConvertedState* state = result.state;
+		if (!json)
+		{
+			if (state)
+			{
+				for (const std::string& line : state->report.lines)
+					std::printf("%s\n", line.c_str());
+			}
+			if (!result.output.empty())
+				std::printf("Wrote native save state: %s\n", result.output.c_str());
+			if (!result.ok)
+				std::printf("FAILED: %s\n", result.error.c_str());
+			return;
+		}
+
+		const u32 target = (state && state->target_format) ? state->target_format : (g_SaveVersion >> 16);
+		std::string text = fmt::format("{{\"ok\":{},\"targetFormat\":\"{:04X}\"", result.ok ? "true" : "false", target);
+		if (state && state->source_version != 0)
+		{
+			text += fmt::format(",\"sourceFormat\":\"{:04X}\",\"sourceBuild\":\"{}\"", state->source_version >> 16,
+				JsonEscape(state->source_build));
+		}
+		if (!result.output.empty())
+			text += fmt::format(",\"output\":\"{}\"", JsonEscape(result.output));
+		if (!result.ok)
+			text += fmt::format(",\"error\":\"{}\"", JsonEscape(result.error));
+		text += ",\"report\":[";
+		if (state)
+		{
+			for (size_t i = 0; i < state->report.lines.size(); i++)
+				text += fmt::format("{}\"{}\"", i ? "," : "", JsonEscape(state->report.lines[i]));
+		}
+		text += "]}";
+		std::printf("%s\n", text.c_str());
+	}
+} // namespace
+
+int wmain(int argc, wchar_t** argv)
+{
+	std::vector<std::string> args;
+	for (int i = 1; i < argc; i++)
+		args.push_back(StringUtil::WideStringToUTF8String(argv[i]));
+
+	bool json = false;
+	if (!args.empty() && args.front() == "--json")
+	{
+		json = true;
+		args.erase(args.begin());
+	}
+
+	if (args.size() == 1 && args[0] == "formats")
+	{
+		// Forward routes only: every source to this build's format, older sources to every
+		// newer stable format.
+		static constexpr const char* routes[][2] = {{"9A4F", "9A50"}, {"9A4F", "9A54"}, {"9A50", "9A54"},
+			{"9A4F", "9A55"}, {"9A50", "9A55"}, {"9A54", "9A55"}};
+		const u32 native = g_SaveVersion >> 16;
+		if (json)
+		{
+			std::printf("{\"routes\":[");
+			for (const char* source : {"9A4F", "9A50", "9A54", "9A55"})
+				std::printf("{\"source\":\"%s\",\"target\":\"%04X\"},", source, native);
+			for (size_t i = 0; i < std::size(routes); i++)
+				std::printf("{\"source\":\"%s\",\"target\":\"%s\"}%s", routes[i][0], routes[i][1], i + 1 < std::size(routes) ? "," : "");
+			std::printf("]}\n");
+		}
+		else
+		{
+			std::printf("sources: 0x9A4F (2.0.x), 0x9A50 (2.2.0), 0x9A54 (2.4.0), 0x9A55 (2.6.x) -> 0x%04X\n", native);
+			for (const auto& route : routes)
+				std::printf("0x%s -> 0x%s\n", route[0], route[1]);
+		}
+		return 0;
+	}
+
+	u16 target_format = 0;
+	for (size_t i = 0; i + 1 < args.size(); i++)
+	{
+		if (args[i] != "--target")
+			continue;
+		target_format = static_cast<u16>(std::strtoul(args[i + 1].c_str(), nullptr, 16));
+		if (target_format != (g_SaveVersion >> 16) && target_format != SaveStateLegacy::TargetFormat9A55 &&
+			target_format != SaveStateLegacy::TargetFormat9A54 && target_format != SaveStateLegacy::TargetFormat9A50)
+		{
+			std::fprintf(stderr, "unsupported target format '%s'\n", args[i + 1].c_str());
+			return 2;
+		}
+		args.erase(args.begin() + i, args.begin() + i + 2);
+		break;
+	}
+
+	const bool inspect = args.size() == 2 && args[0] == "inspect";
+	const bool convert = args.size() == 3 && args[0] == "convert";
+	if (!inspect && !convert)
+	{
+		std::fprintf(stderr, "usage: pcsx2-stateconvert [--json] inspect <state.p2s> | convert <legacy.p2s> <output.p2s> "
+							 "[--target 9A50|9A54|9A55|9A59] | formats\n");
+		return 2;
+	}
+
+	SaveStateLegacy::ConvertedState state;
+	state.report.echo_to_console = false;
+	state.target_format = target_format;
+	Result result;
+	result.state = &state;
+
+	zip_error_t ze = {};
+	auto zf = zip_open_managed(args[1].c_str(), ZIP_RDONLY, &ze);
+	if (!zf)
+	{
+		result.error = fmt::format("cannot open '{}': {}", args[1], zip_error_strerror(&ze));
+		Print(result, json);
+		return 1;
+	}
+
+	Error error;
+	result.ok = SaveStateLegacy::ConvertArchive(zf.get(), &state, &error);
+	if (!result.ok)
+	{
+		result.error = error.GetDescription();
+		Print(result, json);
+		return 1;
+	}
+
+	if (convert)
+	{
+		if (!SaveStateLegacy::WriteArchive(state, args[2].c_str(), &error))
+		{
+			result.ok = false;
+			result.error = error.GetDescription();
+			Print(result, json);
+			return 3;
+		}
+		result.output = args[2];
+	}
+
+	result.exit_code = 0;
+	Print(result, json);
+	return 0;
+}
