<Window x:Class="SaveStateConverter.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCSX2 SaveState Converter" Height="760" Width="1240" MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Icon="app.ico"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Save-State Folder..." InputGestureText="Ctrl+O" Click="BrowseSource" />
                <MenuItem Header="Include _Subfolders" IsCheckable="True" IsChecked="{Binding Recursive}" />
                <MenuItem Header="_Scan Again" InputGestureText="F5" Command="{Binding ScanCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitClick" />
            </MenuItem>
            <MenuItem Header="_Convert">
                <MenuItem Header="_Convert Selected" Command="{Binding ConvertCommand}" />
                <Separator />
                <MenuItem Header="{Binding SelectAllText}" Command="{Binding SelectConvertibleCommand}" />
                <MenuItem Header="Select _None" Command="{Binding ClearSelectionCommand}" />
                <Separator />
                <MenuItem Header="_Details..." InputGestureText="Enter" Click="ShowDetails" />
                <MenuItem Header="Show in _Folder" Click="ShowInFolder" />
            </MenuItem>
            <MenuItem Header="_Backups">
                <MenuItem Header="_Manage Backups..." Click="ShowBackups" />
                <MenuItem Header="_Open Backup Folder" Command="{Binding OpenBackupCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About PCSX2 SaveState Converter" Click="ShowAbout" />
            </MenuItem>
        </Menu>

        <!-- Tool bar -->
        <Border DockPanel.Dock="Top" Padding="6,3,6,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <ComboBox Width="180" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Margin="0,0,6,0"
                              ToolTip="Show save states by status" AutomationProperties.AutomationId="StatusFilter" AutomationProperties.Name="Status filter">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Width="230">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchKeyDown"
                                 ToolTip="Search by game, disc ID or slot (Ctrl+F); Esc clears"
                                 AutomationProperties.AutomationId="Search" AutomationProperties.Name="Search save states" />
                        <TextBlock Text="Search..." Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource DisabledTextBrush}"
                                   Visibility="{Binding Search, Converter={StaticResource WhenEmpty}}" />
                    </Grid>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ToolButton}" Click="BrowseSource" ToolTip="Open save-state folder (Ctrl+O)"
                            AutomationProperties.AutomationId="BrowseSource" AutomationProperties.Name="Open save-state folder">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                    </Button>
                    <TextBox Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" Margin="4,0,2,0"
                             ToolTip="Folder with your PCSX2 save states, usually Documents\PCSX2\sstates"
                             AutomationProperties.AutomationId="SourceFolder" AutomationProperties.Name="Save-state folder" />
                    <Button Grid.Column="2" Style="{StaticResource ToolButton}" Command="{Binding ScanCommand}" ToolTip="Scan again (F5)"
                            AutomationProperties.AutomationId="Scan" AutomationProperties.Name="Scan again">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                    </Button>
                    <Border Grid.Column="3" Width="1" Margin="8,3" Background="{StaticResource FrameBrush}" />
                    <TextBlock Grid.Column="4" Text="Convert for" VerticalAlignment="Center" Margin="2,0,8,0" />
                    <ComboBox Grid.Column="5" Width="210" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"
                              ToolTip="The PCSX2 version you will play on (in PCSX2: Help &gt; About)"
                              AutomationProperties.AutomationId="Target" AutomationProperties.Name="Convert for" />
                    <Border Grid.Column="6" Width="1" Margin="8,3" Background="{StaticResource FrameBrush}" />
                    <Button Grid.Column="7" Style="{StaticResource ToolButton}" Click="ShowBackups" ToolTip="Backups of replaced save states"
                            AutomationProperties.AutomationId="ManageBackups" AutomationProperties.Name="Backups">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" />
                            <TextBlock Text="Backups" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Shown only when the converter is missing -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,6" Padding="12,7" CornerRadius="3" Background="#4A2222" BorderBrush="#8A3A3A" BorderThickness="1"
                Visibility="{Binding ConverterMissing, Converter={StaticResource Visible}}">
            <TextBlock TextWrapping="Wrap" Text="{Binding ConverterMissingText, Mode=OneWay}" AutomationProperties.AutomationId="ConverterMissing" />
        </Border>

        <!-- Result of the last conversion -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,6" Style="{StaticResource Banner}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding DismissBannerCommand}" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="DismissBanner" />
                <Button DockPanel.Dock="Right" Content="{Binding OpenResultText}" Command="{Binding OpenResultCommand}" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="OpenResult" />
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="BannerText" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" AutomationProperties.AutomationId="Summary" />
                <TextBlock Grid.Column="1" Text="{Binding SearchStatus}" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" AutomationProperties.AutomationId="SearchStatus" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.AutomationId="Status" />
                <Grid Grid.Column="3" Width="200" Height="18" Visibility="{Binding Busy, Converter={StaticResource Visible}}">
                    <ProgressBar Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding Progress, Mode=OneWay}" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Output options and the Convert button -->
        <Grid DockPanel.Dock="Bottom" Margin="8,2,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Converted save states">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton GroupName="Mode" IsChecked="{Binding SaveCopies}" Content="Save _copies in" Margin="0,0,0,6"
                                 ToolTip="Your originals stay untouched. Afterwards, copy the converted files into your new PCSX2's sstates folder."
                                 AutomationProperties.AutomationId="SaveCopies" AutomationProperties.Name="Save converted copies" />
                    <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" IsEnabled="{Binding SaveCopies}"
                             Margin="10,0,6,6" AutomationProperties.AutomationId="OutputFolder" AutomationProperties.Name="Folder for converted copies" />
                    <Button Grid.Column="2" Content="Browse..." Click="BrowseOutput" IsEnabled="{Binding SaveCopies}" Margin="0,0,0,6"
                            AutomationProperties.AutomationId="BrowseOutput" />
                    <RadioButton Grid.Row="1" GroupName="Mode" IsChecked="{Binding InPlace}" Content="_Replace the originals, backing them up to"
                                 ToolTip="For when old and new PCSX2 share one sstates folder. Each original is copied to the backup folder first; Backups puts them back. Close PCSX2 first."
                                 AutomationProperties.AutomationId="ReplaceOriginals" AutomationProperties.Name="Replace the originals" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BackupFolder, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                             IsEnabled="{Binding InPlace}" Margin="10,0,6,0" AutomationProperties.AutomationId="BackupFolder" AutomationProperties.Name="Backup folder" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseBackup" IsEnabled="{Binding InPlace}"
                            AutomationProperties.AutomationId="BrowseBackup" />
                </Grid>
            </GroupBox>
            <StackPanel Grid.Column="1" Width="250" Margin="12,8,0,0" VerticalAlignment="Bottom">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" MinHeight="40"
                        AutomationProperties.AutomationId="Convert" AutomationProperties.Name="Convert">
                    <TextBlock Text="{Binding ConvertText}" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Content="{Binding SelectAllText}" Command="{Binding SelectConvertibleCommand}" Margin="0,0,3,0"
                            ToolTip="Select every shown save state that can be converted" AutomationProperties.AutomationId="SelectConvertible" />
                    <Button Content="Select None" Command="{Binding ClearSelectionCommand}" Margin="3,0,0,0" ToolTip="Clear the whole selection"
                            AutomationProperties.AutomationId="SelectNone" />
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- Save states, like PCSX2's game list -->
        <DataGrid x:Name="StatesGrid" Margin="8,0,8,4" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Current}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="30" MouseDoubleClick="RowDoubleClick" PreviewKeyDown="GridKeyDown"
                  AutomationProperties.AutomationId="States">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Details..." InputGestureText="Enter" Click="ShowDetails" />
                    <MenuItem Header="Show in _Folder" Click="ShowInFolder" />
                    <Separator />
                    <MenuItem Header="{Binding SelectAllText}" Command="{Binding SelectConvertibleCommand}" />
                    <MenuItem Header="Select _None" Command="{Binding ClearSelectionCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="38" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConvert}"
                                      HorizontalAlignment="Center" ToolTip="Convert this save state" AutomationProperties.Name="{Binding FileName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Type" Width="48" CanUserResize="False" SortMemberPath="KindText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding KindGlyph}" FontSize="16" ToolTip="{Binding KindText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Code" Binding="{Binding Serial}" Width="96" />
                <DataGridTemplateColumn Header="Title" Width="3*" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="150" />
                <DataGridTemplateColumn Header="Made With" Width="2*" SortMemberPath="MadeWith">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MadeWith}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MadeWith}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="2*" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <StackPanel.ToolTip>
                                    <ToolTip MaxWidth="480">
                                        <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <Ellipse Style="{StaticResource StatusDot}" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
