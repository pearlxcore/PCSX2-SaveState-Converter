<Application x:Class="SaveStateConverter.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SaveStateConverter.Gui"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Fusion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />
            <local:NullVisibility x:Key="WhenSet" />
            <local:NullVisibility x:Key="WhenNull" Invert="True" />
            <local:EmptyVisibility x:Key="WhenEmpty" />
            <local:EmptyVisibility x:Key="WhenNotEmpty" Invert="True" />

            <!-- Colored dot for a save state's status. -->
            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="9" />
                <Setter Property="Height" Value="9" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="#8B8B8B" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                        <Setter Property="Fill" Value="#3FB950" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Converted">
                        <Setter Property="Fill" Value="#3FB950" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="ReadyUntested">
                        <Setter Property="Fill" Value="#58A6FF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Working">
                        <Setter Property="Fill" Value="#58A6FF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="NotSupported">
                        <Setter Property="Fill" Value="#E3A008" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                        <Setter Property="Fill" Value="#E3A008" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Damaged">
                        <Setter Property="Fill" Value="#F85149" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                        <Setter Property="Fill" Value="#F85149" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Result bar above the list. -->
            <Style x:Key="Banner" TargetType="Border">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="#1D3B26" />
                <Setter Property="BorderBrush" Value="#2E6B3A" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Banner}" Value="None">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Banner}" Value="Warning">
                        <Setter Property="Background" Value="#43361A" />
                        <Setter Property="BorderBrush" Value="#8A6D1F" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
